    .use-card,\n    .stat-item {\n        padding: 0.75rem 0.5rem !important;\n    }\n\n    /* Fix mobile alignment for benefits/feature cards on small screens */\n    .benefits .glass {\n        padding: 1.25rem 1rem !important;\n    }\n\n    .benefits .glass h3 {\n        font-size: 1.125rem !important;\n        margin-bottom: 0.75rem !important;\n    }\n\n    .benefits .glass p {\n        font-size: 0.9rem !important;\n        line-height: 1.5 !important;\n        margin-bottom: 0.75rem !important;\n    }\n\n    .benefits .glass ul {\n        font-size: 0.85rem !important;\n    }\n\n    .benefits .glass li {\n        margin-bottom: 0.375rem !important;\n    }\n\n    /* More balanced padding for enterprise CTA */\n    .enterprise-cta .glass {\n        padding: 1.5rem 1rem !important;\n    }\n\n    .enterprise-cta .grid .glass {\n        padding: 1.25rem 0.75rem !important;\n    }\n\n    /* More balanced padding for all glass cards */\n    .glass.p-8 {\n        padding: 1.25rem 0.75rem !important;\n    }\n\n    .faq .glass {\n        padding: 1.25rem 0.75rem !important;\n    }\n\n    .footer-panel {\n        padding: 1.5rem 1rem !important;\n    }\n\n    /* Extra small mobile touch targets */\n    .marketing-btn-primary,\n    .marketing-btn-secondary {\n        min-height: 48px !important;\n        min-width: 48px !important;\n    }\n\n    /* Reduce all margins even more on very small screens */\n    .mb-16 {\n        margin-bottom: 1rem !important;\n    }\n\n    .mb-12 {\n        margin-bottom: 0.75rem !important;\n    }\n\n    .mb-8 {\n        margin-bottom: 0.5rem !important;\n    }\n\n    .mb-6 {\n        margin-bottom: 0.5rem !important;\n    }\n}\n\n/* Mobile-specific improvements for better UX */\n@media (max-width: 768px) {\n    /* Improve touch targets */\n    a,\n    button,\n    input,\n    select,\n    textarea {\n        min-height: 44px;\n        min-width: 44px;\n    }\n\n    /* Better text readability on mobile */\n    body {\n        -webkit-text-size-adjust: 100%;\n        -ms-text-size-adjust: 100%;\n    }\n\n    /* Prevent horizontal scroll */\n    html,\n    body {\n        overflow-x: hidden;\n    }\n\n    /* Improve scrolling performance */\n    * {\n        -webkit-overflow-scrolling: touch;\n    }\n\n    /* Better focus states for mobile */\n    a:focus,\n    button:focus,\n    input:focus,\n    select:focus,\n    textarea:focus {\n        outline: 2px solid #6366f1;\n        outline-offset: 2px;\n    }\n\n    /* Fix oversized pill-shaped buttons on mobile */\n    .inline-flex.rounded-full {\n        display: block !important;\n        width: 100% !important;\n        max-width: 100% !important;\n        text-align: center !important;\n        border-radius: 12px !important;\n        padding: 0.75rem 1rem !important;\n        font-size: 0.875rem !important;\n        line-height: 1.4 !important;\n    }\n\n    /* Ensure long text in buttons wraps properly */\n    .inline-flex.rounded-full,\n    .bg-gradient-to-r.rounded-full {\n        white-space: normal !important;\n        word-wrap: break-word !important;\n        overflow-wrap: break-word !important;\n    }\n\n    /* Fix any remaining pill-shaped elements */\n    .rounded-full {\n        border-radius: 12px !important;\n    }\n}\n\n@media (min-width: 1024px) {\n    .code-panel__pre {\n        font-size: 0.98rem;\n    }\n}\n\n.reveal {\n    opacity: 0;\n    transform: translateY(10px);\n    transition: opacity 700ms cubic-bezier(0.2, 0.8, 0.2, 1),\n        transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);\n}\n.reveal.is-visible {\n    opacity: 1;\n    transform: translateY(0);\n}\n.reveal-delay-1 {\n    transition-delay: 80ms;\n}\n.reveal-delay-2 {\n    transition-delay: 160ms;\n}\n.reveal-delay-3 {\n    transition-delay: 240ms;\n}\n.reveal-delay-4 {\n    transition-delay: 320ms;\n}\n\n@media (prefers-reduced-motion: reduce) {\n    .reveal,\n    .reveal.is-visible {\n        opacity: 1 !important;\n        transform: none !important;\n        transition: none !important;\n    }\n}\n\n.rr-glow-pulse {\n    animation: rrGlowPulse 3.2s ease-in-out infinite;\n}\n@keyframes rrGlowPulse {\n    0%,\n    100% {\n        box-shadow: 0 0 0 rgba(90, 69, 255, 0);\n    }\n    50% {\n        box-shadow: 0 0 24px rgba(90, 69, 255, 0.18);\n    }\n}\n\n@media (prefers-reduced-motion: reduce) {\n    .rr-glow-pulse {\n        animation: none !important;\n    }\n}\n\n.rr-signup-dash {\n    animation: rrSignupDash 6s ease-in-out infinite;\n}\n@keyframes rrSignupDash {\n    0% {\n        stroke-dashoffset: 0;\n        opacity: 0.35;\n    }\n    50% {\n        stroke-dashoffset: -320;\n        opacity: 0.85;\n    }\n    100% {\n        stroke-dashoffset: -640;\n        opacity: 0.35;\n    }\n}\n\n.rr-signup-dot {\n    animation: rrSignupDot 6s ease-in-out infinite;\n    transform-origin: center;\n}\n@keyframes rrSignupDot {\n    0% {\n        transform: translateX(0);\n        opacity: 0.15;\n    }\n    50% {\n        transform: translateX(480px);\n        opacity: 0.35;\n    }\n    100% {\n        transform: translateX(960px);\n        opacity: 0.15;\n    }\n}\n\n@media (prefers-reduced-motion: reduce) {\n    .rr-signup-dash,\n    .rr-signup-dot {\n        animation: none !important;\n    }\n}\n\n/* Company Logo Cloud Section */\n.rr-logo-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 0.75rem;\n}\n\n@media (min-width: 480px) {\n    .rr-logo-grid {\n        grid-template-columns: repeat(3, 1fr);\n        gap: 0.875rem;\n    }\n}\n\n@media (min-width: 640px) {\n    .rr-logo-grid {\n        grid-template-columns: repeat(4, 1fr);\n        gap: 1rem;\n    }\n}\n\n@media (min-width: 900px) {\n    .rr-logo-grid {\n        grid-template-columns: repeat(5, 1fr);\n        gap: 1.125rem;\n    }\n}\n\n@media (min-width: 1024px) {\n    .rr-logo-grid {\n        grid-template-columns: repeat(6, 1fr);\n        gap: 1.25rem;\n    }\n}\n\n.rr-logo {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 64px;\n    padding: 1rem 0.75rem;\n    background: rgba(255, 255, 255, 0.025);\n    border: 1px solid rgba(255, 255, 255, 0.06);\n    border-radius: 10px;\n    text-decoration: none;\n    transition: transform 0.18s cubic-bezier(0.25, 0.46, 0.45, 0.94),\n        border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;\n}\n\n.rr-logo:hover,\n.rr-logo:focus-visible {\n    transform: translateY(-1px);\n    background: rgba(255, 255, 255, 0.045);\n    border-color: rgba(255, 255, 255, 0.14);\n    box-shadow: 0 4px 12px -4px rgba(0, 0, 0, 0.3),\n        0 0 0 1px rgba(255, 255, 255, 0.05);\n}\n\n.rr-logo:focus-visible {\n    outline: none;\n    box-shadow: 0 4px 12px -4px rgba(0, 0, 0, 0.3),\n        0 0 0 2px rgba(99, 102, 241, 0.5);\n}\n\n.rr-logo:hover::after,\n.rr-logo:focus-visible::after {\n    opacity: 0.06;\n}\n\n.rr-logo__img {\n    max-width: 100%;\n    height: 24px;\n    width: auto;\n    object-fit: contain;\n    filter: grayscale(1) brightness(1.6) contrast(0.95) url(#dither-hover);\n    opacity: 0.75;\n    transition: filter 0.18s ease, opacity 0.18s ease, transform 0.18s ease;\n}\n\n@media (min-width: 640px) {\n    .rr-logo__img {\n        height: 28px;\n    }\n}\n\n.rr-logo:hover .rr-logo__img,\n.rr-logo:focus-visible .rr-logo__img {\n    filter: grayscale(0);\n    opacity: 1;\n}\n\n/* Weight-based logo scaling for visual rhythm */\n.rr-logo--hero .rr-logo__img {\n    height: 28px;\n}\n\n.rr-logo--small .rr-logo__img {\n    height: 20px;\n}\n\n@media (min-width: 640px) {\n    .rr-logo--hero .rr-logo__img {\n        height: 34px;\n    }\n    .rr-logo--small .rr-logo__img {\n        height: 24px;\n    }\n}\n\n/* Dark logo handling */\n.rr-logo--dark .rr-logo__img {\n    filter: grayscale(1) invert(1) url(#dither-hover);\n    opacity: 0.8;\n}\n\n.rr-logo--dark:hover,\n.rr-logo--dark:focus-visible {\n    background: rgba(255, 255, 255, 0.92);\n    border-color: rgba(255, 255, 255, 0.92);\n}\n\n.rr-logo--dark:hover .rr-logo__img,\n.rr-logo--dark:focus-visible .rr-logo__img {\n    filter: grayscale(0) invert(0);\n    opacity: 1;\n}\n\n/* Error state */\n.rr-logo--error {\n    min-height: 64px;\n}\n\n.rr-logo--error .rr-logo__img {\n    display: none;\n}\n\n.rr-logo__fallback {\n    display: none;\n    font-size: 0.7rem;\n    font-weight: 500;\n    color: rgba(255, 255, 255, 0.5);\n    text-align: center;\n    line-height: 1.3;\n    letter-spacing: 0.01em;\n}\n\n.rr-logo--error .rr-logo__fallback {\n    display: block;\n}\n\n/* Empty state */\n#company-logos-grid:empty::before {\n    content: 'Trusted by developers at leading companies worldwide.';\n    display: block;\n    grid-column: 1 / -1;\n    text-align: center;\n    color: rgba(255, 255, 255, 0.5);\n    font-size: 0.875rem;\n    padding: 1rem;\n}\n\n/* CTA wrapper - centered below logo grid */\n.rr-logo-cta-wrapper {\n    display: flex;\n    justify-content: center;\n    margin-top: 1rem;\n}\n\n/* CTA card */\n.rr-logo--cta {\n    border-style: dashed;\n    border-color: rgba(255, 255, 255, 0.12);\n    background: transparent;\n}\n\n.rr-logo--cta::after {\n    display: none;\n}\n\n.rr-logo--cta:hover,\n.rr-logo--cta:focus-visible {\n    border-color: rgba(99, 102, 241, 0.5);\n    background: rgba(99, 102, 241, 0.08);\n}\n\n.rr-logo__cta-text {\n    display: flex;\n    align-items: center;\n    gap: 0.375rem;\n    font-size: 0.75rem;\n    font-weight: 500;\n    color: rgba(255, 255, 255, 0.5);\n    transition: color 0.18s ease;\n    white-space: nowrap;\n}\n\n.rr-logo--cta:hover .rr-logo__cta-text,\n.rr-logo--cta:focus-visible .rr-logo__cta-text {\n    color: rgba(255, 255, 255, 0.85);\n}\n\n.rr-logo__cta-plus {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 18px;\n    height: 18px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, 0.08);\n    font-size: 0.875rem;\n    font-weight: 400;\n    line-height: 1;\n    transition: background 0.18s ease, transform 0.18s ease;\n}\n\n.rr-logo--cta:hover .rr-logo__cta-plus,\n.rr-logo--cta:focus-visible .rr-logo__cta-plus {\n    background: rgba(99, 102, 241, 0.4);\n    transform: scale(1.1);\n}\n\n/* Reduced motion */\n@media (prefers-reduced-motion: reduce) {\n    .rr-logo {\n        transition: none;\n        transform: none !important;\n    }\n    .rr-logo::after {\n        transition: none;\n    }\n    .rr-logo__img {\n        transition: none;\n        filter: grayscale(1) brightness(1.6) contrast(0.95);\n    }\n    .rr-logo--dark .rr-logo__img {\n        filter: grayscale(1) invert(1);\n    }\n    .rr-logo:hover,\n    .rr-logo:focus-visible {\n        transform: none;\n    }\n    .rr-logo:hover .rr-logo__img,\n    .rr-logo:focus-visible .rr-logo__img {\n        filter: grayscale(0);\n    }\n    .rr-logo--dark:hover .rr-logo__img,\n    .rr-logo--dark:focus-visible .rr-logo__img {\n        filter: grayscale(0) invert(0);\n    }\n    .rr-logo__cta-text,\n    .rr-logo__cta-plus {\n        transition: none;\n    }\n    .rr-logo--cta:hover .rr-logo__cta-plus,\n    .rr-logo--cta:focus-visible .rr-logo__cta-plus {\n        transform: none;\n    }\n}\n\n/* Disable animated dither on touch/mobile devices for performance */\n@media (pointer: coarse) {\n    .rr-logo__img {\n        filter: grayscale(1) brightness(1.6) contrast(0.95);\n    }\n    .rr-logo--dark .rr-logo__img {\n        filter: grayscale(1) invert(1);\n    }\n}\n"
