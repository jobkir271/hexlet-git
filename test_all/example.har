            "size": -1,
            "mimeType": "text/html; charset=utf-8",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <!-- Google Tag Manager -->\n        <script>\n            ;(function (w, d, s, l, i) {\n                w[l] = w[l] || []\n                w[l].push({\n                    'gtm.start': new Date().getTime(),\n                    event: 'gtm.js',\n                })\n                var f = d.getElementsByTagName(s)[0],\n                    j = d.createElement(s),\n                    dl = l != 'dataLayer' ? '&l=' + l : ''\n                j.async = true\n                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl\n                f.parentNode.insertBefore(j, f)\n            })(window, document, 'script', 'dataLayer', 'GTM-KB622KF')\n        </script>\n        <!-- End Google Tag Manager -->\n        <script\n            src=\"https://analytics.ahrefs.com/analytics.js\"\n            data-key=\"JuVKDRQ5EM9I8yXFMoHuXw\"\n            async\n        ></script>\n        <script src=\"https://js.stripe.com/v3/\"></script>\n        <meta charset=\"utf-8\" />\n        <meta\n            name=\"viewport\"\n            content=\"width=device-width, initial-scale=1.0\"\n        />\n        <meta\n            name=\"description\"\n            content=\"Free REST API for testing and prototyping with real responses, no signup needed. Or build your own backend with collections, auth, and logs at app.reqres.in.\"\n        />\n        <title>ReqRes | Free REST API for developers | ReqRes</title>\n        <link\n            rel=\"icon\"\n            type=\"image/png\"\n            href=\"/img/logo-dark.jpg\"\n            alt=\"ReqRes Logo\"\n        />\n        <link\n            rel=\"canonical\"\n            href=\"https://reqres.in\"\n        />\n        <meta\n            property=\"og:title\"\n            content=\"ReqRes | Free REST API for developers\"\n        />\n        <meta\n            property=\"og:description\"\n            content=\"Free REST API for testing and prototyping with real responses, no signup needed. Or build your own backend with collections, auth, and logs at app.reqres.in.\"\n        />\n        <meta\n            property=\"og:image\"\n            content=\"https://reqres.in/img/reqres-og-2x.png\"\n        />\n        <meta\n            property=\"og:url\"\n            content=\"https://reqres.in\"\n        />\n        <meta property=\"og:site_name\" content=\"ReqRes\" />\n        <meta property=\"og:type\" content=\"website\" />\n        <meta name=\"twitter:card\" content=\"summary_large_image\" />\n        <meta\n            name=\"twitter:title\"\n            content=\"ReqRes | Free REST API for developers\"\n        />\n        <meta\n            name=\"twitter:description\"\n            content=\"Free REST API for testing and prototyping with real responses, no signup needed. Or build your own backend with collections, auth, and logs at app.reqres.in.\"\n        />\n        <meta\n            name=\"twitter:image\"\n            content=\"https://reqres.in/img/reqres-og-2x.png\"\n        />\n        <meta name=\"theme-color\" content=\"#4f46e5\" />\n        <link rel=\"stylesheet\" href=\"/css/app.css\" />\n        <link rel=\"stylesheet\" href=\"/css/tailwind.css\" />\n        <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n        <link\n            href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap\"\n            rel=\"stylesheet\"\n        />\n        <link rel=\"stylesheet\" href=\"/css/design.css\" />\n        <script type=\"text/javascript\">\n        function resolvePdSDKFunction(e,...t){return new Promise((n,i)=>{!function r(){window.PDPromotionUISDK&&\"function\"==typeof window.PDPromotionUISDK[e]?window.PDPromotionUISDK[e](...t).then(n).catch(i):setTimeout(r,100)}()})}!function(e,t,n,i,r,a,c){e[i]=e[i]||function(){(e[i].q=e[i].q||[]).push(Array.prototype.slice.call(arguments))},a=t.createElement(n),c=t.getElementsByTagName(n)[0],a.id=\"parity-deals-sdk\",a.async=1,a.src=r,c.parentNode.insertBefore(a,c)}(window,document,\"script\",\"PDPromotionUISDK\",\"https://cdn.paritydeals.com/js-promotions-ui/1.0.0/js-promotions-ui.umd.js\"),window.PDPromotionUI={init:function(e){return resolvePdSDKFunction(\"init\",e)},getUpdatedPrice:function(e,t){return resolvePdSDKFunction(\"getUpdatedPrice\",e,t)},updatePriceElement:function(e,t){return resolvePdSDKFunction(\"updatePriceElement\",e,t)},updatePrice:function(e){return resolvePdSDKFunction(\"updatePrice\",e)}};\n        </script>\n        <script type=\"application/ld+json\">\n            {\n                \"@context\": \"https://schema.org\",\n                \"@type\": \"SoftwareApplication\",\n                \"name\": \"ReqRes – Frontend-first backend\",\n                \"description\": \"ReqRes is the frontend-first backend you call with fetch(). Projects bundle collections, app users, logs, and automations-no backend code required.\",\n                \"url\": \"https://reqres.in\",\n                \"applicationCategory\": \"DeveloperApplication\",\n                \"operatingSystem\": \"Web\",\n                \"offers\": [\n                    {\n                        \"@type\": \"Offer\",\n                        \"name\": \"Free Plan\",\n                        \"price\": \"0\",\n                        \"priceCurrency\": \"USD\",\n                        \"description\": \"Start a project with collections, app users, and logs for prototypes, QA, and learning REST.\"\n                    },\n                    {\n                        \"@type\": \"Offer\",\n                        \"name\": \"Pro Plan\",\n                        \"price\": \"9\",\n                        \"priceCurrency\": \"USD\",\n                        \"description\": \"Production-ready backend for frontend developers and QA teams shipping real apps.\"\n                    },\n                    {\n                        \"@type\": \"Offer\",\n                        \"name\": \"Premium Plan\",\n                        \"price\": \"29\",\n                        \"priceCurrency\": \"USD\",\n                        \"description\": \"Higher limits, automations, and org features for production workloads.\"\n                    },\n                    {\n                        \"@type\": \"Offer\",\n                        \"name\": \"Enterprise Plan\",\n                        \"description\": \"Custom limits, SLAs, security reviews, and dedicated support.\"\n                    }\n                ],\n                \"featureList\": [\n                    \"Collections as a JSON database for your app\",\n                    \"Magic-link auth and project-scoped app users\",\n                    \"App-session tokens to scope data per user\",\n                    \"Built-in Data Explorer and request logs\",\n                    \"Automations and webhooks on collection events\",\n                    \"Keys and permissions for admin vs client usage\",\n                    \"Frontend-only integration via fetch(), no backend code\",\n                    \"Client-only apps, QA automation, and teaching REST/HTTP\",\n                    \"Ideal for MVPs, production apps, and internal tools\"\n                ]\n            }\n        </script>\n        <script type=\"application/ld+json\">\n            {\n                \"@context\": \"https://schema.org\",\n                \"@type\": \"FAQPage\",\n                \"mainEntity\": [\n                    {\n                        \"@type\": \"Question\",\n                        \"name\": \"What is a frontend-first backend?\",\n                        \"acceptedAnswer\": {\n                            \"@type\": \"Answer\",\n                            \"text\": \"A frontend-first backend gives you production-grade data, auth, and automations without standing up servers. ReqRes lets you create projects with collections, app users, magic-link auth, and logs so your frontend can ship with real data and stay production-ready.\"\n                        }\n                    },\n                    {\n                        \"@type\": \"Question\",\n                        \"name\": \"How do custom endpoints work?\",\n                        \"acceptedAnswer\": {\n                            \"@type\": \"Answer\",\n                            \"text\": \"Custom endpoints let you shape responses around your collections or specific UX flows. Define the path, method, and response data-ideal for staging environments, automation callbacks, and UI experiments. Higher limits are available on Premium.\"\n                        }\n                    },\n                    {\n                        \"@type\": \"Question\",\n                        \"name\": \"What are the different API key types?\",\n                        \"acceptedAnswer\": {\n                            \"@type\": \"Answer\",\n                            \"text\": \"ReqRes offers three API key permission levels: read-only (GET only), read/write (GET, POST, PUT, PATCH), and manage (includes DELETE operations). Use admin keys for managing collections and automations; use session tokens for per-user data access.\"\n                        }\n                    },\n                    {\n                        \"@type\": \"Question\",\n                        \"name\": \"What is the Data Explorer?\",\n                        \"acceptedAnswer\": {\n                            \"@type\": \"Answer\",\n                            \"text\": \"The Data Explorer is a web interface that lets you browse collections, inspect request logs, and debug user journeys. Filter and export your stored objects with richer observability on paid plans.\"\n                        }\n                    },\n                    {\n                        \"@type\": \"Question\",\n                        \"name\": \"Can I use ReqRes for production?\",\n                        \"acceptedAnswer\": {\n                            \"@type\": \"Answer\",\n                            \"text\": \"Yes. Pro and Premium provide persistent collections, app users, automations, and observability suitable for production workloads. SLA and security reviews are available on Enterprise.\"\n                        }\n                    },\n                    {\n                        \"@type\": \"Question\",\n                        \"name\": \"How does the Image to API feature work?\",\n                        \"acceptedAnswer\": {\n                            \"@type\": \"Answer\",\n                            \"text\": \"The Image to API feature uses AI to analyze UI screenshots and automatically generate working API endpoints. Upload a screenshot of your design (or a Figma frame), and we generate REST endpoints and schemas you can deploy. Available on all plans with different usage limits; deployment requires Pro or above.\"\n                        }\n                    }\n                ]\n            }\n        </script>\n    </head>\n    <body class=\"dark-site bg-black text-white\">\n        <!--\n          Cross-subdomain signed-in awareness. The dashboard (app.reqres.in)\n          writes `rr_signed_in=1` on domain `.reqres.in` when Clerk has a\n          user. This tiny inline script runs before <main> and adds an\n          `rr-signed-in` class to <html> so downstream CSS + the welcome\n          banner below can react without a second network request.\n        -->\n        <script>\n            (function () {\n                try {\n                    if (/(?:^|;\\s*)rr_signed_in=1(?:;|$)/.test(document.cookie)) {\n                        document.documentElement.classList.add('rr-signed-in');\n                    }\n                } catch (e) { /* ignore */ }\n            })();\n        </script>\n        <div\n            id=\"rr-welcome-back-banner\"\n            style=\"display: none; background: rgba(16, 185, 129, 0.08); border-bottom: 1px solid rgba(16, 185, 129, 0.18); position: relative; z-index: 60;\"\n        >\n            <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between gap-3 text-sm\">\n                <span style=\"color: rgba(255,255,255,0.78);\">\n                    Welcome back - you're signed in.\n                </span>\n                <a\n                    href=\"https://app.reqres.in/dashboard\"\n                    style=\"color: #6ee7b7; font-weight: 500; text-decoration: none;\"\n                >\n                    Open your dashboard →\n                </a>\n            </div>\n        </div>\n        <style>\n            html.rr-signed-in #rr-welcome-back-banner { display: block !important; }\n        </style>\n        <main role=\"main\"><script>\n    ;(() => {\n        if (typeof document !== 'undefined' && document.body) {\n            document.body.classList.add('landing-modern')\n        }\n        document.addEventListener('DOMContentLoaded', () => {\n            document.body.classList.add('landing-modern')\n        })\n    })()\n</script>\n<style>\n    body.landing-modern .header-content {\n        display: none;\n    }\n    body.landing-modern main.wrap.home-content {\n        max-width: 100%;\n        padding: 0;\n        margin: 0;\n    }\n    .rr-accent {\n        color: #6ee7b7;\n    }\n    .live-dot {\n        width: 10px;\n        height: 10px;\n        border-radius: 9999px;\n        background: #22c55e;\n        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.4);\n        animation: liveDotPulse 1.8s ease-in-out infinite;\n        display: inline-block;\n    }\n    @keyframes liveDotPulse {\n        0% {\n            transform: scale(0.9);\n            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.35);\n            opacity: 0.85;\n        }\n        50% {\n            transform: scale(1.15);\n            box-shadow: 0 0 0 8px rgba(34, 197, 94, 0);\n            opacity: 1;\n        }\n        100% {\n            transform: scale(0.9);\n            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);\n            opacity: 0.85;\n        }\n    }\n    @keyframes float-slow {\n        0% {\n            transform: translateY(0px);\n        }\n        50% {\n            transform: translateY(-3px);\n        }\n        100% {\n            transform: translateY(0px);\n        }\n    }\n    @keyframes pulse-line {\n        0% {\n            opacity: 0.15;\n        }\n        50% {\n            opacity: 0.7;\n        }\n        100% {\n            opacity: 0.15;\n        }\n    }\n    @keyframes draw-line {\n        to {\n            stroke-dashoffset: 0;\n        }\n    }\n    @keyframes shimmer-soft {\n        0% {\n            opacity: 0.15;\n        }\n        50% {\n            opacity: 0.6;\n        }\n        100% {\n            opacity: 0.15;\n        }\n    }\n    @keyframes pulse-move {\n        0% {\n            opacity: 0;\n            transform: translateX(0);\n        }\n        15% {\n            opacity: 0.9;\n        }\n        50% {\n            opacity: 0.9;\n            transform: translateX(140px);\n        }\n        85% {\n            opacity: 0.9;\n        }\n        100% {\n            opacity: 0;\n            transform: translateX(160px);\n        }\n    }\n    @keyframes enterprise-shimmer {\n        0% {\n            transform: translateX(-80%);\n            opacity: 0;\n        }\n        25% {\n            opacity: 0.4;\n        }\n        60% {\n            opacity: 0.4;\n        }\n        100% {\n            transform: translateX(120%);\n            opacity: 0;\n        }\n    }\n\n    .enterprise-bar {\n        position: relative;\n        overflow: hidden;\n        isolation: isolate;\n    }\n    .enterprise-bar::after {\n        content: '';\n        position: absolute;\n        inset: 0;\n        background: linear-gradient(\n            120deg,\n            rgba(255, 255, 255, 0) 0%,\n            rgba(255, 255, 255, 0.08) 45%,\n            rgba(255, 255, 255, 0) 80%\n        );\n        transform: translateX(-80%);\n        animation: enterprise-shimmer 4s ease-in-out infinite;\n        pointer-events: none;\n        z-index: 0;\n    }\n    .enterprise-content {\n        position: relative;\n        z-index: 1;\n    }\n    .dash-path {\n        stroke-dasharray: 6 6;\n        stroke-dashoffset: 220;\n    }\n    .pulse-path {\n        opacity: 0.15;\n    }\n    .is-visible .dash-path.dash-animate {\n        animation: draw-line 1.8s ease forwards;\n    }\n    .is-visible .pulse-path.pulse-animate {\n        animation: pulse-line 6s ease-in-out infinite;\n    }\n    .rr-dash {\n        animation: rrDash 12s ease-in-out infinite;\n    }\n    @keyframes rrDash {\n        0% {\n            stroke-dashoffset: 0;\n            opacity: 0.7;\n        }\n        50% {\n            stroke-dashoffset: 64;\n            opacity: 1;\n        }\n        100% {\n            stroke-dashoffset: 0;\n            opacity: 0.7;\n        }\n    }\n    .rr-shimmer {\n        animation: rrShimmer 10s ease-in-out infinite;\n    }\n    @keyframes rrShimmer {\n        0%,\n        100% {\n            opacity: 0.65;\n        }\n        50% {\n            opacity: 1;\n        }\n    }\n    .rr-pulse {\n        animation: rrPulse 2.8s ease-in-out infinite;\n    }\n    @keyframes rrPulse {\n        0%,\n        100% {\n            transform: scale(1);\n            opacity: 0.65;\n        }\n        50% {\n            transform: scale(1.25);\n            opacity: 1;\n        }\n    }\n    .rr-pulse-dot {\n        display: inline-block;\n        width: 10px;\n        height: 10px;\n        border-radius: 9999px;\n    }\n    .rr-pulse-dot-sky {\n        background: rgba(125, 211, 252, 0.9);\n        box-shadow: 0 0 0 6px rgba(125, 211, 252, 0.16);\n    }\n    .rr-pulse-dot-amber {\n        background: rgba(251, 191, 36, 0.9);\n        box-shadow: 0 0 0 6px rgba(251, 191, 36, 0.16);\n    }\n    .rr-automap {\n        display: inline-flex;\n        align-items: center;\n        gap: 0.4rem;\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-size: 0.95em;\n    }\n    .rr-automap-action {\n        color: rgba(125, 211, 252, 0.95);\n    }\n    .rr-automap-arrow {\n        color: rgba(255, 255, 255, 0.6);\n    }\n    .rr-automap-target {\n        color: rgba(52, 211, 153, 0.95);\n    }\n    /* Hero ambient animation: subtle dash drift + tiny pulse */\n    .rr-hero-dash {\n        animation: rrHeroDash 14s ease-in-out infinite;\n    }\n    .rr-hero-dash-slow {\n        animation-duration: 18s;\n        opacity: 0.5;\n    }\n    @keyframes rrHeroDash {\n        0% {\n            stroke-dashoffset: 0;\n            opacity: 0.55;\n        }\n        50% {\n            stroke-dashoffset: 90;\n            opacity: 0.95;\n        }\n        100% {\n            stroke-dashoffset: 0;\n            opacity: 0.55;\n        }\n    }\n    .rr-hero-pulse {\n        transform-origin: center;\n        animation: rrHeroPulse 3.2s ease-in-out infinite;\n    }\n    @keyframes rrHeroPulse {\n        0%,\n        100% {\n            transform: scale(1);\n            opacity: 0.18;\n        }\n        50% {\n            transform: scale(1.4);\n            opacity: 0.42;\n        }\n    }\n    .rr-life-dash {\n        animation: rrLifeDash 14s ease-in-out infinite;\n    }\n    @keyframes rrLifeDash {\n        0% {\n            stroke-dashoffset: 0;\n            opacity: 0.45;\n        }\n        50% {\n            stroke-dashoffset: 120;\n            opacity: 0.85;\n        }\n        100% {\n            stroke-dashoffset: 0;\n            opacity: 0.45;\n        }\n    }\n    .rr-life-node {\n        transform-origin: center;\n        animation: rrLifeNode 3.2s ease-in-out infinite;\n    }\n    .rr-life-node:nth-child(2) {\n        animation-delay: 0.2s;\n    }\n    .rr-life-node:nth-child(3) {\n        animation-delay: 0.4s;\n    }\n    .rr-life-node:nth-child(4) {\n        animation-delay: 0.6s;\n    }\n    .rr-life-node:nth-child(5) {\n        animation-delay: 0.8s;\n    }\n    .rr-life-node:nth-child(6) {\n        animation-delay: 1s;\n    }\n    @keyframes rrLifeNode {\n        0%,\n        100% {\n            transform: scale(1);\n            opacity: 0.25;\n        }\n        50% {\n            transform: scale(1.35);\n            opacity: 0.65;\n        }\n    }\n    /* Recommended plan highlight */\n    .pro-card {\n        z-index: 1;\n    }\n    .pro-card::before {\n        content: '';\n        position: absolute;\n        inset: -1px;\n        padding: 1px;\n        border-radius: inherit;\n        background: linear-gradient(\n            120deg,\n            rgba(90, 69, 255, 0.65),\n            rgba(126, 225, 255, 0.45),\n            rgba(90, 69, 255, 0.65)\n        );\n        background-size: 220% 220%;\n        animation: proCardBorder 9s ease-in-out infinite;\n        z-index: 2;\n        -webkit-mask: linear-gradient(#000 0 0) content-box,\n            linear-gradient(#000 0 0);\n        -webkit-mask-composite: xor;\n        mask-composite: exclude;\n        pointer-events: none;\n        opacity: 0.7;\n        box-sizing: border-box;\n    }\n    @keyframes proCardBorder {\n        0% {\n            background-position: 0% 50%;\n            opacity: 0.6;\n        }\n        50% {\n            background-position: 100% 50%;\n            opacity: 0.95;\n        }\n        100% {\n            background-position: 0% 50%;\n            opacity: 0.6;\n        }\n    }\n    .pricing-grid {\n        padding-block: 0;\n    }\n    /* Footer ambient animation: subtle dash drift + tiny pulse */\n    .rr-footer-dash {\n        animation: rrFooterDash 14s ease-in-out infinite;\n    }\n    .rr-footer-dash-slow {\n        animation-duration: 18s;\n        opacity: 0.55;\n    }\n    @keyframes rrFooterDash {\n        0% {\n            stroke-dashoffset: 0;\n            opacity: 0.55;\n        }\n        50% {\n            stroke-dashoffset: 110;\n            opacity: 1;\n        }\n        100% {\n            stroke-dashoffset: 0;\n            opacity: 0.55;\n        }\n    }\n    .rr-footer-pulse {\n        transform-origin: center;\n        animation: rrFooterPulse 3.4s ease-in-out infinite;\n    }\n    @keyframes rrFooterPulse {\n        0%,\n        100% {\n            transform: scale(1);\n            opacity: 0.14;\n        }\n        50% {\n            transform: scale(1.35);\n            opacity: 0.32;\n        }\n    }\n    /* Tagline progressive emphasis */\n    .reveal-on-scroll {\n        opacity: 0;\n        transform: translateY(6px);\n        transition: opacity 0.6s ease, transform 0.6s ease;\n    }\n    .reveal-on-scroll.is-visible {\n        opacity: 1;\n        transform: translateY(0);\n    }\n    .rr-fade {\n        display: inline-block;\n        margin-right: 0.35em;\n    }\n    .reveal-on-scroll .rr-fade {\n        opacity: 0;\n    }\n    .reveal-on-scroll.is-visible .rr-fade {\n        animation: rrFadeIn 0.8s ease forwards;\n    }\n    .reveal-on-scroll.is-visible .rr-fade:nth-child(1) {\n        animation-delay: 0.1s;\n    }\n    .reveal-on-scroll.is-visible .rr-fade:nth-child(2) {\n        animation-delay: 0.6s;\n    }\n    .reveal-on-scroll.is-visible .rr-fade:nth-child(3) {\n        animation-delay: 1.1s;\n    }\n    @keyframes rrFadeIn {\n        from {\n            opacity: 0;\n            transform: translateY(2px);\n        }\n        to {\n            opacity: 0.65;\n            transform: translateY(0);\n        }\n    }\n    .rr-emphasis {\n        color: rgba(255, 255, 255, 0.95);\n        font-weight: 500;\n    }\n    .rr-loop {\n        position: relative;\n    }\n    .reveal-on-scroll.is-visible .rr-loop {\n        animation: rrEmphasisLoop 6s ease-in-out infinite;\n    }\n    .rr-loop code {\n        transition: color 240ms ease, text-shadow 240ms ease;\n    }\n    .rr-loop:hover code {\n        color: rgba(255, 255, 255, 0.95);\n    }\n    @keyframes rrEmphasisLoop {\n        0%,\n        75%,\n        100% {\n            opacity: 0.92;\n            filter: none;\n        }\n        82% {\n            opacity: 1;\n            filter: drop-shadow(0 0 10px rgba(90, 69, 255, 0.12));\n        }\n        90% {\n            opacity: 1;\n            filter: drop-shadow(0 0 14px rgba(90, 69, 255, 0.18));\n        }\n    }\n    .rr-tool {\n        color: #6ee7b7;\n    }\n    .rr-tool-2 {\n        animation-delay: 1.2s;\n    }\n    .rr-tool-3 {\n        animation-delay: 2.4s;\n    }\n    .rr-tool-4 {\n        animation-delay: 3.6s;\n    }\n    .rr-tool-hero {\n        filter: drop-shadow(0 0 10px rgba(114, 215, 255, 0.12));\n    }\n    @keyframes rrToolGradient {\n        0%,\n        100% {\n            background-position: 0% 50%;\n        }\n        50% {\n            background-position: 100% 50%;\n        }\n    }\n    .rr-emphasis code {\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        color: rgba(255, 255, 255, 0.9);\n    }\n    .rr-http-dash {\n        animation: none;\n    }\n    .reveal-on-scroll.is-visible .rr-http-dash {\n        animation: rrHttpPulse 4.8s ease-in-out infinite;\n    }\n    @keyframes rrHttpPulse {\n        0% {\n            stroke-dashoffset: 420;\n            opacity: 0.22;\n        }\n        45% {\n            stroke-dashoffset: 0;\n            opacity: 0.85;\n        }\n        100% {\n            stroke-dashoffset: -420;\n            opacity: 0.22;\n        }\n    }\n    [data-reveal] {\n        opacity: 0;\n        transform: translateY(12px);\n        transition: opacity 0.6s ease, transform 0.6s ease;\n    }\n    .reveal-on-scroll[data-reveal] {\n        transform: translateY(6px);\n    }\n    .is-visible[data-reveal] {\n        opacity: 1;\n        transform: translateY(0);\n    }\n    /* Navigation polish */\n    .rr-nav {\n        display: flex;\n        gap: 1.75rem;\n    }\n    .rr-nav-link {\n        position: relative;\n        font-size: 14px;\n        font-weight: 500;\n        color: rgba(255, 255, 255, 0.65);\n        text-decoration: none;\n        padding: 6px 0;\n        transition: color 180ms ease, transform 180ms ease;\n    }\n    .rr-nav-link:hover,\n    .rr-nav-link:focus-visible {\n        color: rgba(255, 255, 255, 0.95);\n        outline: none;\n        transform: translateY(-1px);\n    }\n    .rr-nav-link::after {\n        content: '';\n        position: absolute;\n        left: 0;\n        bottom: -4px;\n        width: 100%;\n        height: 2px;\n        background: linear-gradient(\n            90deg,\n            rgba(52, 211, 153, 0),\n            rgba(52, 211, 153, 0.7),\n            rgba(52, 211, 153, 0)\n        );\n        transform: scaleX(0);\n        transform-origin: center;\n        opacity: 0;\n        transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),\n            opacity 220ms ease;\n    }\n    .rr-nav-link:hover::after,\n    .rr-nav-link:focus-visible::after {\n        transform: scaleX(1);\n        opacity: 1;\n    }\n    .rr-nav-link.is-active {\n        color: rgba(255, 255, 255, 0.98);\n    }\n    .rr-nav-link.is-active::after {\n        transform: scaleX(1);\n        opacity: 1;\n    }\n    /* Hide scrollbar on mobile nav */\n    .overflow-x-auto::-webkit-scrollbar {\n        display: none;\n    }\n    /* Hero staggered entrance */\n    .hero-enter {\n        opacity: 0;\n        transform: translateY(20px);\n        animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n    }\n    .hero-enter-1 { animation-delay: 0.05s; }\n    .hero-enter-2 { animation-delay: 0.12s; }\n    .hero-enter-3 { animation-delay: 0.2s; }\n    .hero-enter-4 { animation-delay: 0.28s; }\n    .hero-enter-5 { animation-delay: 0.36s; }\n    .hero-enter-6 { animation-delay: 0.5s; }\n    @keyframes heroFadeUp {\n        from {\n            opacity: 0;\n            transform: translateY(20px);\n        }\n        to {\n            opacity: 1;\n            transform: translateY(0);\n        }\n    }\n\n    /* Primary CTA - emerald glow */\n    .cta-primary {\n        background: rgb(16, 185, 129);\n        color: white;\n        font-weight: 600;\n        border-radius: 12px;\n        border: 1px solid rgba(52, 211, 153, 0.3);\n        box-shadow: 0 0 20px rgba(16, 185, 129, 0.15),\n                    0 0 60px rgba(16, 185, 129, 0.05);\n        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n        animation: heroCTAPulse 3s ease-in-out 2s infinite;\n    }\n    .cta-primary:hover {\n        background: rgb(52, 211, 153);\n        box-shadow: 0 0 30px rgba(52, 211, 153, 0.25),\n                    0 0 80px rgba(52, 211, 153, 0.08);\n        transform: translateY(-2px);\n    }\n    .cta-primary:active {\n        transform: translateY(0) scale(0.98);\n    }\n    @keyframes heroCTAPulse {\n        0%, 100% { box-shadow: 0 0 20px rgba(16, 185, 129, 0.15), 0 0 60px rgba(16, 185, 129, 0.05); }\n        50% { box-shadow: 0 0 30px rgba(16, 185, 129, 0.25), 0 0 80px rgba(16, 185, 129, 0.1); }\n    }\n\n    /* Secondary CTA - ghost text link */\n    .cta-secondary {\n        color: rgba(255, 255, 255, 0.5);\n        transition: color 0.3s ease;\n    }\n    .cta-secondary:hover {\n        color: rgba(255, 255, 255, 0.75);\n    }\n\n    /* Scroll hint animation */\n    .hero-scroll-hint {\n        animation: heroFadeUp 0.9s cubic-bezier(0.4, 0, 0.1, 1) 0.85s both;\n    }\n    .hero-scroll-hint svg {\n        animation: scrollHintBob 2.5s ease-in-out 2s infinite;\n    }\n    @keyframes scrollHintBob {\n        0%, 100% { transform: translateY(0); opacity: 0.4; }\n        50% { transform: translateY(5px); opacity: 0.8; }\n    }\n\n    /* Hero ambient glow - responsive */\n    .hero-bg-glow {\n        position: absolute;\n        top: 30%;\n        left: 50%;\n        width: 400px;\n        height: 280px;\n        transform: translate(-50%, -50%);\n        background: radial-gradient(\n            ellipse at center,\n            rgba(16, 185, 129, 0.06) 0%,\n            rgba(16, 185, 129, 0.02) 40%,\n            transparent 70%\n        );\n        animation: ambientBreathe 6s ease-in-out infinite;\n        pointer-events: none;\n        z-index: 0;\n    }\n    @media (min-width: 640px) {\n        .hero-bg-glow {\n            width: 600px;\n            height: 400px;\n        }\n    }\n    @keyframes ambientBreathe {\n        0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }\n        50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }\n    }\n    /* Hero pill dot pulse */\n    .hero-dot {\n        animation: liveDotPulse 2.4s ease-in-out infinite;\n    }\n    @media (prefers-reduced-motion: reduce) {\n        [data-reveal] {\n            animation: none !important;\n            opacity: 1 !important;\n            transform: none !important;\n        }\n        .reveal-on-scroll {\n            opacity: 1 !important;\n            transform: none !important;\n        }\n        .animate-float {\n            animation: none !important;\n        }\n        .pulse-path,\n        .dash-path {\n            animation: none !important;\n        }\n        .shimmer-soft,\n        .pulse-move {\n            animation: none !important;\n        }\n        .enterprise-bar::after {\n            animation: none !important;\n        }\n        .rr-dash,\n        .rr-shimmer,\n        .rr-pulse {\n            animation: none !important;\n        }\n        .rr-hero-dash,\n        .rr-hero-pulse {\n            animation: none !important;\n        }\n        .rr-footer-dash,\n        .rr-footer-pulse {\n            animation: none !important;\n        }\n        .rr-fade,\n        .rr-http-dash {\n            animation: none !important;\n            opacity: 1 !important;\n        }\n        .rr-loop {\n            animation: none !important;\n            filter: none !important;\n            opacity: 1 !important;\n        }\n        .rr-tool {\n            animation: none !important;\n            background-position: 50% 50% !important;\n        }\n        .rr-nav-link,\n        .rr-nav-link::after {\n            transition: none !important;\n        }\n        .hero-enter {\n            animation: none !important;\n            opacity: 1 !important;\n            transform: none !important;\n        }\n        .hero-scroll-hint,\n        .hero-scroll-hint svg {\n            animation: none !important;\n            opacity: 1 !important;\n        }\n        .cta-primary {\n            animation: none !important;\n        }\n        .hero-bg-glow {\n            animation: none !important;\n            opacity: 0.7 !important;\n        }\n        .hero-dot {\n            animation: none !important;\n        }\n    }\n</style>\n\n\n<!-- PAGE SHELL -->\n<div class=\"bg-black text-white\">\n    <a href=\"#hero\" class=\"sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:rounded-lg focus:text-sm focus:font-medium\">Skip to content</a>\n    <!-- NAV -->\n    <nav\n        class=\"sticky top-0 z-50 backdrop-blur bg-black/40 border-b border-white/5\"\n        aria-label=\"Main navigation\"\n    >\n        <div\n            class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-2 sm:py-3\"\n        >\n            <!-- Tablet and up: single row -->\n            <div class=\"hidden sm:flex items-center justify-between\">\n                <a class=\"flex items-center gap-2.5 group\" href=\"/\">\n                    <div class=\"w-[30px] h-[30px] rounded-lg border border-emerald-400/15 bg-emerald-400/[0.04] flex items-center justify-center text-[13px] font-bold text-emerald-300/70 tracking-tight transition-all duration-300 group-hover:border-emerald-400/25 group-hover:bg-emerald-400/[0.07]\">R</div>\n                    <span class=\"text-[15px] font-medium text-white/75 tracking-tight\">Req<span class=\"text-emerald-300/60\">Res</span></span>\n                </a>\n\n                <div class=\"flex items-center rr-nav\">\n                    <a href=\"#pricing\" class=\"rr-nav-link\">Pricing</a>\n                    <a href=\"/teams\" class=\"rr-nav-link\">Teams</a>\n                    <a href=\"/blog\" class=\"rr-nav-link\">Blog</a>\n                    <a\n                        href=\"/docs\"\n                        class=\"rr-nav-link\"\n                        data-visitors-event=\"Docs CTA\"\n                        data-visitors-source=\"nav\"\n                        >Docs</a\n                    >\n                    <a href=\"/about\" class=\"rr-nav-link\">About</a>\n                </div>\n\n                <a\n                    href=\"https://app.reqres.in/\"\n                    class=\"inline-flex items-center gap-1.5 px-4 py-1.5 text-[13px] font-medium text-white/60 border border-white/[0.08] rounded-lg bg-white/[0.02] hover:border-white/[0.15] hover:text-white/80 hover:bg-white/[0.04] transition-all duration-300\"\n                    data-visitors-event=\"Signup CTA\"\n                    data-visitors-source=\"nav\"\n                >\n                    Get Started\n                    <svg class=\"w-3 h-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                </a>\n            </div>\n\n            <!-- Mobile only: logo + CTA row, then scrollable nav row -->\n            <div class=\"sm:hidden space-y-2\">\n                <div class=\"flex items-center justify-between\">\n                    <a class=\"flex items-center gap-2 group shrink-0\" href=\"/\">\n                        <div class=\"w-[28px] h-[28px] rounded-lg border border-emerald-400/15 bg-emerald-400/[0.04] flex items-center justify-center text-[12px] font-bold text-emerald-300/70 tracking-tight\">R</div>\n                        <span class=\"text-[14px] font-medium text-white/75 tracking-tight leading-none\">Req<span class=\"text-emerald-300/60\">Res</span></span>\n                    </a>\n\n                    <a\n                        href=\"https://app.reqres.in/\"\n                        class=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-[13px] font-medium text-white/60 border border-white/[0.08] rounded-lg bg-white/[0.02] hover:border-white/[0.15] hover:text-white/80 hover:bg-white/[0.04] transition-all duration-300 shrink-0\"\n                        data-visitors-event=\"Signup CTA\"\n                        data-visitors-source=\"nav\"\n                    >\n                        Get Started\n                        <svg class=\"w-3 h-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                    </a>\n                </div>\n\n                <div class=\"flex items-center gap-4 overflow-x-auto -mx-4 px-4\" style=\"-webkit-overflow-scrolling: touch; scrollbar-width: none;\">\n                    <a href=\"#pricing\" class=\"rr-nav-link text-xs shrink-0\">Pricing</a>\n                    <a href=\"/teams\" class=\"rr-nav-link text-xs shrink-0\">Teams</a>\n                    <a href=\"/blog\" class=\"rr-nav-link text-xs shrink-0\">Blog</a>\n                    <a\n                        href=\"/docs\"\n                        class=\"rr-nav-link text-xs shrink-0\"\n                        data-visitors-event=\"Docs CTA\"\n                        data-visitors-source=\"nav\"\n                        >Docs</a\n                    >\n                    <a href=\"/about\" class=\"rr-nav-link text-xs shrink-0\">About</a>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- HERO -->\n    <section\n        id=\"hero\"\n        class=\"min-h-[85vh] sm:min-h-[90vh] flex items-center justify-center pt-20 pb-12 sm:pt-24 sm:pb-16 md:pt-28 md:pb-20 relative overflow-hidden\"\n    >\n        <!-- Ambient emerald glow -->\n        <div class=\"hero-bg-glow\"></div>\n\n        <div\n            class=\"pointer-events-none absolute left-0 right-0 -top-20 h-[920px]\"\n        >\n            <!-- SVG background -->\n            <svg\n                class=\"absolute top-0 inset-0 h-full w-full\"\n                viewBox=\"0 -80 1440 900\"\n                preserveAspectRatio=\"xMidYMin slice\"\n                fill=\"none\"\n                xmlns=\"http://www.w3.org/2000/svg\"\n                aria-hidden=\"true\"\n            >\n                <defs>\n                    <!-- soft vignette mask so the art fades at edges -->\n                    <radialGradient\n                        id=\"rrHeroMask\"\n                        cx=\"0\"\n                        cy=\"0\"\n                        r=\"1\"\n                        gradientUnits=\"userSpaceOnUse\"\n                        gradientTransform=\"translate(720 180) rotate(90) scale(520 920)\"\n                    >\n                        <stop stop-color=\"#FFFFFF\" stop-opacity=\"0.22\" />\n                        <stop\n                            offset=\"0.55\"\n                            stop-color=\"#FFFFFF\"\n                            stop-opacity=\"0.10\"\n                        />\n                        <stop\n                            offset=\"1\"\n                            stop-color=\"#FFFFFF\"\n                            stop-opacity=\"0\"\n                        />\n                    </radialGradient>\n\n                    <!-- subtle indigo glow -->\n                    <radialGradient\n                        id=\"rrHeroGlow\"\n                        cx=\"0\"\n                        cy=\"0\"\n                        r=\"1\"\n                        gradientUnits=\"userSpaceOnUse\"\n                        gradientTransform=\"translate(980 240) rotate(120) scale(520 420)\"\n                    >\n                        <stop stop-color=\"#5a45ff\" stop-opacity=\"0.16\" />\n                        <stop\n                            offset=\"1\"\n                            stop-color=\"#5a45ff\"\n                            stop-opacity=\"0\"\n                        />\n                    </radialGradient>\n\n                    <!-- stroke gradients -->\n                    <linearGradient\n                        id=\"rrHeroStroke\"\n                        x1=\"260\"\n                        y1=\"180\"\n                        x2=\"1180\"\n                        y2=\"520\"\n                        gradientUnits=\"userSpaceOnUse\"\n                    >\n                        <stop stop-color=\"#FFFFFF\" stop-opacity=\"0\" />\n                        <stop\n                            offset=\"0.45\"\n                            stop-color=\"#FFFFFF\"\n                            stop-opacity=\"0.14\"\n                        />\n                        <stop\n                            offset=\"1\"\n                            stop-color=\"#FFFFFF\"\n                            stop-opacity=\"0\"\n                        />\n                    </linearGradient>\n\n                    <linearGradient\n                        id=\"rrHeroAccent\"\n                        x1=\"420\"\n                        y1=\"240\"\n                        x2=\"1220\"\n                        y2=\"520\"\n                        gradientUnits=\"userSpaceOnUse\"\n                    >\n                        <stop stop-color=\"#5a45ff\" stop-opacity=\"0\" />\n                        <stop\n                            offset=\"0.5\"\n                            stop-color=\"#5a45ff\"\n                            stop-opacity=\"0.6\"\n                        />\n                        <stop\n                            offset=\"1\"\n                            stop-color=\"#5a45ff\"\n                            stop-opacity=\"0\"\n                        />\n                    </linearGradient>\n                </defs>\n\n                <!-- indigo glow blob -->\n                <rect\n                    y=\"-80\"\n                    width=\"1440\"\n                    height=\"840\"\n                    fill=\"url(#rrHeroGlow)\"\n                    opacity=\"1\"\n                />\n\n                <!-- flow lines group, masked by radial gradient -->\n                <g opacity=\"0.95\">\n                    <!-- faint base arcs -->\n                    <path\n                        d=\"M120 520 C 360 220, 620 220, 860 520\"\n                        stroke=\"url(#rrHeroStroke)\"\n                        stroke-width=\"2\"\n                        stroke-linecap=\"round\"\n                        opacity=\"0.55\"\n                    />\n                    <path\n                        d=\"M260 600 C 520 280, 760 280, 1120 560\"\n                        stroke=\"url(#rrHeroStroke)\"\n                        stroke-width=\"2\"\n                        stroke-linecap=\"round\"\n                        opacity=\"0.45\"\n                    />\n                    <path\n                        d=\"M80 340 C 360 120, 840 120, 1320 360\"\n                        stroke=\"url(#rrHeroStroke)\"\n                        stroke-width=\"2\"\n                        stroke-linecap=\"round\"\n                        opacity=\"0.35\"\n                    />\n\n                    <!-- animated dashed accent arcs -->\n                    <path\n                        class=\"rr-hero-dash\"\n                        d=\"M140 520 C 380 235, 640 235, 900 520\"\n                        stroke=\"url(#rrHeroAccent)\"\n                        stroke-width=\"3\"\n                        stroke-linecap=\"round\"\n                        stroke-dasharray=\"7 10\"\n                        opacity=\"0.9\"\n                    />\n\n                    <path\n                        class=\"rr-hero-dash rr-hero-dash-slow\"\n                        d=\"M220 600 C 520 300, 760 300, 1100 560\"\n                        stroke=\"url(#rrHeroAccent)\"\n                        stroke-width=\"3\"\n                        stroke-linecap=\"round\"\n                        stroke-dasharray=\"6 12\"\n                        opacity=\"0.55\"\n                    />\n\n                    <!-- subtle “tick” marks (Linear-ish) -->\n                    <g opacity=\"0.18\">\n                        <path\n                            d=\"M560 250 l-20 10\"\n                            stroke=\"rgba(255,255,255,0.7)\"\n                            stroke-width=\"2\"\n                            stroke-linecap=\"round\"\n                        />\n                        <path\n                            d=\"M610 230 l-18 12\"\n                            stroke=\"rgba(255,255,255,0.7)\"\n                            stroke-width=\"2\"\n                            stroke-linecap=\"round\"\n                        />\n                        <path\n                            d=\"M660 215 l-16 14\"\n                            stroke=\"rgba(255,255,255,0.7)\"\n                            stroke-width=\"2\"\n                            stroke-linecap=\"round\"\n                        />\n                        <path\n                            d=\"M710 208 l-14 15\"\n                            stroke=\"rgba(255,255,255,0.7)\"\n                            stroke-width=\"2\"\n                            stroke-linecap=\"round\"\n                        />\n                        <path\n                            d=\"M760 206 l-12 16\"\n                            stroke=\"rgba(255,255,255,0.7)\"\n                            stroke-width=\"2\"\n                            stroke-linecap=\"round\"\n                        />\n                        <path\n                            d=\"M810 210 l-10 17\"\n                            stroke=\"rgba(255,255,255,0.7)\"\n                            stroke-width=\"2\"\n                            stroke-linecap=\"round\"\n                        />\n                    </g>\n\n                    <!-- a single pulse dot (optional) -->\n                    <circle\n                        class=\"rr-hero-pulse\"\n                        cx=\"900\"\n                        cy=\"520\"\n                        r=\"4.5\"\n                        fill=\"rgba(90,69,255,0.9)\"\n                        opacity=\"0.35\"\n                    />\n                </g>\n\n                <!-- vignette mask overlay -->\n                <rect\n                    width=\"1440\"\n                    height=\"760\"\n                    fill=\"url(#rrHeroMask)\"\n                    opacity=\"0.75\"\n                />\n            </svg>\n\n            <!-- extra vignette to protect legibility (keep subtle) -->\n            <div\n                class=\"absolute inset-0 bg-gradient-to-b from-black/35 via-black/10 to-black/40\"\n            ></div>\n        </div>\n        <div\n            class=\"relative z-10 max-w-5xl mx-auto px-5 sm:px-6 md:px-10 lg:px-12 text-left\"\n        >\n            <div>\n                <!-- Eyebrow -->\n                <p\n                    class=\"hero-enter hero-enter-1 text-[10px] sm:text-[11px] uppercase tracking-[0.18em] sm:tracking-[0.2em] text-white/50 sm:text-white/45 font-medium mb-6 sm:mb-8\"\n                >\n                    The API your test suites already use\n                </p>\n                <!-- Headline -->\n                <h1\n                    class=\"hero-enter hero-enter-2 text-[32px] sm:text-5xl md:text-6xl lg:text-7xl xl:text-[80px] font-semibold tracking-[-0.02em] leading-[1.1] sm:leading-[1.05] mb-6 sm:mb-8\"\n                >\n                    <span class=\"text-white\">A real backend -</span><br class=\"hidden sm:block\" />\n                    <span class=\"text-white\">for testing and building</span><span class=\"text-white/40\">.</span>\n                </h1>\n                <!-- Subhead -->\n                <p\n                    class=\"hero-enter hero-enter-3 text-[15px] sm:text-lg md:text-xl leading-[1.5] max-w-[320px] sm:max-w-xl md:max-w-2xl mb-8 sm:mb-10\"\n                    style=\"color: rgba(255, 255, 255, 0.5);\"\n                >\n                    Stable endpoints for QA automation. Persistent data for your apps.<br class=\"hidden sm:block\" />\n                    No servers. No DevOps. Start in 30 seconds.\n                </p>\n                <!-- Primary CTA -->\n                <div class=\"hero-cta hero-enter hero-enter-4\">\n                    <a\n                        href=\"https://app.reqres.in\"\n                        class=\"cta-primary inline-flex items-center justify-center text-[15px] sm:text-base px-6 py-2.5 sm:px-8 sm:py-3.5\"\n                        data-visitors-event=\"Signup CTA\"\n                        data-visitors-source=\"hero\"\n                    >\n                        Create your backend\n                    </a>\n                </div>\n\n                <!-- Reassurance + secondary link -->\n                <div class=\"hero-reassurance hero-enter hero-enter-5 mt-4 sm:mt-5 space-y-2.5\">\n                    <p class=\"text-[12px] sm:text-[13px]\" style=\"color: rgba(255, 255, 255, 0.4);\">\n                        Free to try. No card required. Your test suite works in 30 seconds.\n                    </p>\n                    <a\n                        href=\"/teams\"\n                        class=\"inline-flex items-center gap-1.5 text-[13px] sm:text-[14px] text-emerald-400/60 hover:text-emerald-400/90 transition-colors group\"\n                        data-visitors-event=\"Teams CTA Click\"\n                        data-visitors-source=\"hero\"\n                    >\n                        <span class=\"underline decoration-emerald-400/20 underline-offset-2 group-hover:decoration-emerald-400/40\">QA teams</span>\n                    </a>\n                    <span class=\"text-white/25 mx-1\">·</span>\n                    <a\n                        href=\"/for/educators\"\n                        class=\"inline-flex items-center gap-1.5 text-[13px] sm:text-[14px] text-white/50 hover:text-white/70 transition-colors group\"\n                        data-visitors-event=\"Persona CTA Click\"\n                        data-visitors-source=\"hero\"\n                    >\n                        <span class=\"underline decoration-white/20 underline-offset-2 group-hover:decoration-white/40\">Educators</span>\n                    </a>\n                    <span class=\"text-white/25 mx-1\">·</span>\n                    <a\n                        href=\"/for/ai-agents\"\n                        class=\"inline-flex items-center gap-1.5 text-[13px] sm:text-[14px] text-white/50 hover:text-white/70 transition-colors group\"\n                        data-visitors-event=\"Persona CTA Click\"\n                        data-visitors-source=\"hero\"\n                    >\n                        <span class=\"underline decoration-white/20 underline-offset-2 group-hover:decoration-white/40\">AI agents</span>\n                    </a>\n                    <span class=\"text-white/25 mx-2\">|</span>\n                    <a\n                        href=\"https://demo.reqres.in\"\n                        class=\"inline-flex items-center gap-1.5 text-[13px] sm:text-[14px] text-emerald-400/60 hover:text-emerald-400/90 transition-colors group\"\n                        data-visitors-event=\"Example App Click\"\n                        data-visitors-source=\"hero\"\n                        target=\"_blank\"\n                        rel=\"noreferrer\"\n                    >\n                        <span class=\"underline decoration-emerald-400/20 underline-offset-2 group-hover:decoration-emerald-400/40\">See a demo</span>\n                        <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <polyline points=\"9 18 15 12 9 6\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <!-- Tagline Definition -->\n                <div class=\"hero-enter hero-enter-6 mt-16 sm:mt-20 max-w-[620px]\">\n                    <!-- Green accent line -->\n                    <div class=\"w-16 h-0.5 bg-gradient-to-r from-emerald-400 to-transparent mb-8\"></div>\n                    <!-- Label -->\n                    <div class=\"text-[10px] sm:text-[11px] uppercase tracking-[0.18em] sm:tracking-[0.2em] text-white/45 font-medium mb-4\">\n                        What is ReqRes?\n                    </div>\n                    <!-- Definition -->\n                    <p class=\"text-[17px] sm:text-[19px] leading-[1.6]\">\n                        <span style=\"color: rgba(255, 255, 255, 0.55);\">ReqRes is a hosted REST API with real endpoints, persistent data, and request logs. Use the free public API for testing - or sign up to create your own backend with custom collections, auth, and logs.</span><br class=\"hidden sm:block\" />\n                        <span class=\"text-white\">Your team's test suites work in 30 seconds. No setup. No servers.</span>\n                    </p>\n                </div>\n\n                <!-- Scroll hint -->\n                <div class=\"hero-scroll-hint mt-10 sm:mt-12\">\n                    <a href=\"#how\" class=\"flex flex-col items-start gap-1.5 group cursor-pointer\">\n                        <span class=\"text-[10px] sm:text-[11px] uppercase tracking-[0.15em] font-medium text-white/35 group-hover:text-white/50 transition-colors\">\n                            See how it works\n                        </span>\n                        <svg class=\"w-4 h-4 text-white/35 group-hover:text-white/50 transition-colors\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\">\n                            <polyline points=\"7 10 12 15 17 10\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- COMPANY LOGO CLOUD -->\n    <!-- SVG Filters for animated dither effect -->\n    <svg class=\"sr-only\" aria-hidden=\"true\">\n        <defs>\n            <filter id=\"dither-filter\" x=\"0\" y=\"0\" width=\"100%\" height=\"100%\">\n                <feTurbulence\n                    type=\"fractalNoise\"\n                    baseFrequency=\"0.8\"\n                    numOctaves=\"4\"\n                    seed=\"0\"\n                    result=\"noise\"\n                >\n                    <animate\n                        attributeName=\"seed\"\n                        from=\"0\"\n                        to=\"100\"\n                        dur=\"0.5s\"\n                        repeatCount=\"indefinite\"\n                    />\n                </feTurbulence>\n                <feDisplacementMap\n                    in=\"SourceGraphic\"\n                    in2=\"noise\"\n                    scale=\"3\"\n                    xChannelSelector=\"R\"\n                    yChannelSelector=\"G\"\n                />\n            </filter>\n            <filter id=\"dither-hover\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n                <feTurbulence\n                    type=\"fractalNoise\"\n                    baseFrequency=\"0.5\"\n                    numOctaves=\"2\"\n                    seed=\"0\"\n                    result=\"noise\"\n                >\n                    <animate\n                        id=\"dither-animation\"\n                        attributeName=\"seed\"\n                        from=\"0\"\n                        to=\"50\"\n                        dur=\"0.4s\"\n                        repeatCount=\"indefinite\"\n                    />\n                </feTurbulence>\n                <feComponentTransfer in=\"noise\" result=\"threshold\">\n                    <feFuncR type=\"discrete\" tableValues=\"0 1\"/>\n                    <feFuncG type=\"discrete\" tableValues=\"0 1\"/>\n                    <feFuncB type=\"discrete\" tableValues=\"0 1\"/>\n                </feComponentTransfer>\n                <feBlend in=\"SourceGraphic\" in2=\"threshold\" mode=\"overlay\" result=\"blended\"/>\n                <!-- Clip to source alpha so dither only shows on logo pixels -->\n                <feComposite in=\"blended\" in2=\"SourceGraphic\" operator=\"in\"/>\n            </filter>\n        </defs>\n    </svg>\n    \n    <section\n        id=\"company-logos\"\n        class=\"border-y border-white/5 bg-white/[0.02] py-12 md:py-16 lg:py-20\"\n        aria-labelledby=\"company-logos-heading\"\n    >\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <h2\n                id=\"company-logos-heading\"\n                class=\"text-2xl md:text-3xl font-semibold tracking-tight mb-8 md:mb-10\"\n            >\n                Trusted by QA teams and developers at\n            </h2>\n            <p class=\"sr-only\">\n                Logos reflect domains used by individual developers and do not imply corporate endorsement.\n            </p>\n            <div\n                id=\"company-logos-grid\"\n                class=\"rr-logo-grid\"\n                role=\"list\"\n                aria-label=\"Company logos\"\n            >\n                <!-- Logos rendered via JS -->\n            </div>\n            <noscript>\n                <p class=\"text-center text-white/50 text-sm\">\n                    Trusted by developers at leading companies worldwide.\n                </p>\n            </noscript>\n        </div>\n    </section>\n\n    <!-- ═══ BEGIN DROP-IN SECTION ═══ -->\n    \n    <style>\n      .diagram-glow::before {\n        content: '';\n        position: absolute;\n        inset: -1px;\n        border-radius: inherit;\n        padding: 1px;\n        background: linear-gradient(135deg, rgba(52,211,153,0.30) 0%, rgba(52,211,153,0.10) 35%, rgba(52,211,153,0.03) 60%, rgba(52,211,153,0) 100%);\n        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n        -webkit-mask-composite: xor;\n        mask-composite: exclude;\n        pointer-events: none;\n      }\n      .infra-node { transition: all 1.1s cubic-bezier(0.4, 0, 0.1, 1); }\n      .client-node { transition: all 1.1s cubic-bezier(0.4, 0, 0.1, 1); }\n      .glow-ring {\n        position: absolute;\n        border-radius: 20px;\n        border: 1px solid rgba(52, 211, 153, 0.08);\n        animation: glowPulse 3s ease-in-out infinite;\n        pointer-events: none;\n      }\n      .glow-ring:nth-child(1) { inset: -14px; animation-delay: 0s; }\n      .glow-ring:nth-child(2) { inset: -30px; border-radius: 28px; animation-delay: 1s; }\n      .glow-ring:nth-child(3) { inset: -46px; border-radius: 36px; animation-delay: 2s; }\n      @keyframes glowPulse { 0%, 100% { opacity: 0.2; } 50% { opacity: 0.7; } }\n      .stress-mark {\n        position: absolute; width: 10px; height: 2px;\n        background: rgba(239, 68, 68, 0.45); border-radius: 1px;\n        animation: stressBlink 0.9s ease-in-out infinite alternate;\n      }\n      .stress-mark:nth-child(1) { top: -6px; left: 50%; transform: translateX(-50%) rotate(-25deg); }\n      .stress-mark:nth-child(2) { top: -4px; right: -4px; transform: rotate(35deg); animation-delay: 0.3s; }\n      .stress-mark:nth-child(3) { top: -7px; left: -2px; transform: rotate(-45deg); animation-delay: 0.5s; }\n      @keyframes stressBlink { 0% { opacity: 0.25; } 100% { opacity: 0.65; } }\n      .svg-line { transition: all 1.1s cubic-bezier(0.4, 0, 0.1, 1); }\n      .phase-btn { transition: all 0.35s ease; }\n    </style>\n    \n    <section class=\"py-10 md:py-14\" id=\"how\">\n      <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"flex justify-center gap-2 mb-8 md:mb-10\" id=\"diagramToggle\">\n          <button data-phase=\"before\" class=\"phase-btn text-[10px] uppercase tracking-[0.14em] font-semibold px-4 py-1.5 rounded-md border cursor-pointer border-emerald-400/25 bg-emerald-500/[0.06] text-emerald-300\">Before</button>\n          <button data-phase=\"with\" class=\"phase-btn text-[10px] uppercase tracking-[0.14em] font-semibold px-4 py-1.5 rounded-md border cursor-pointer border-white/[0.08] bg-transparent text-white/50\">With ReqRes</button>\n        </div>\n        <!-- ═══ DESKTOP DIAGRAM (md+) ═══ -->\n        <div data-reveal class=\"hidden md:block relative w-full overflow-hidden rounded-2xl border border-white/[0.06] bg-white/[0.015]\" style=\"height: 420px;\" id=\"diagramDesktop\">\n          <svg class=\"absolute inset-0 w-full h-full\" viewBox=\"0 0 900 420\" preserveAspectRatio=\"xMidYMid meet\">\n            <line class=\"svg-line before-line\" x1=\"95\" y1=\"90\" x2=\"230\" y2=\"170\" stroke=\"white\" stroke-opacity=\"0.04\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line before-line\" x1=\"230\" y1=\"170\" x2=\"95\" y2=\"260\" stroke=\"white\" stroke-opacity=\"0.04\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line before-line\" x1=\"95\" y1=\"260\" x2=\"230\" y2=\"340\" stroke=\"white\" stroke-opacity=\"0.04\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line before-line\" x1=\"370\" y1=\"120\" x2=\"230\" y2=\"170\" stroke=\"white\" stroke-opacity=\"0.04\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line before-line\" x1=\"370\" y1=\"300\" x2=\"230\" y2=\"340\" stroke=\"white\" stroke-opacity=\"0.04\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line before-line\" x1=\"370\" y1=\"120\" x2=\"370\" y2=\"300\" stroke=\"white\" stroke-opacity=\"0.04\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line before-line\" x1=\"95\" y1=\"90\" x2=\"370\" y2=\"120\" stroke=\"white\" stroke-opacity=\"0.04\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line before-line\" x1=\"95\" y1=\"260\" x2=\"370\" y2=\"300\" stroke=\"white\" stroke-opacity=\"0.04\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line you-line\" x1=\"95\" y1=\"90\" x2=\"680\" y2=\"210\" stroke=\"white\" stroke-opacity=\"0.03\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line you-line\" x1=\"230\" y1=\"170\" x2=\"680\" y2=\"210\" stroke=\"white\" stroke-opacity=\"0.03\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line you-line\" x1=\"95\" y1=\"260\" x2=\"680\" y2=\"210\" stroke=\"white\" stroke-opacity=\"0.03\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line you-line\" x1=\"230\" y1=\"340\" x2=\"680\" y2=\"210\" stroke=\"white\" stroke-opacity=\"0.03\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line you-line\" x1=\"370\" y1=\"120\" x2=\"680\" y2=\"210\" stroke=\"white\" stroke-opacity=\"0.03\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line you-line\" x1=\"370\" y1=\"300\" x2=\"680\" y2=\"210\" stroke=\"white\" stroke-opacity=\"0.03\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n            <line class=\"svg-line after-line\" x1=\"465\" y1=\"190\" x2=\"700\" y2=\"105\" stroke=\"rgb(52,211,153)\" stroke-opacity=\"0\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\"/>\n            <line class=\"svg-line after-line\" x1=\"465\" y1=\"210\" x2=\"700\" y2=\"210\" stroke=\"rgb(52,211,153)\" stroke-opacity=\"0\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\"/>\n            <line class=\"svg-line after-line\" x1=\"465\" y1=\"230\" x2=\"700\" y2=\"315\" stroke=\"rgb(52,211,153)\" stroke-opacity=\"0\" stroke-width=\"1.5\" stroke-dasharray=\"5 4\"/>\n            <circle class=\"svg-line after-dot\" cx=\"700\" cy=\"105\" r=\"2.5\" fill=\"rgb(52,211,153)\" opacity=\"0\"/>\n            <circle class=\"svg-line after-dot\" cx=\"700\" cy=\"210\" r=\"2.5\" fill=\"rgb(52,211,153)\" opacity=\"0\"/>\n            <circle class=\"svg-line after-dot\" cx=\"700\" cy=\"315\" r=\"2.5\" fill=\"rgb(52,211,153)\" opacity=\"0\"/>\n            <circle class=\"after-packet\" r=\"2.5\" fill=\"rgb(52,211,153)\" opacity=\"0\" filter=\"url(#pktGlow)\"><animateMotion dur=\"2.4s\" repeatCount=\"indefinite\" path=\"M465,190 L700,105\"/></circle>\n            <circle class=\"after-packet\" r=\"2.5\" fill=\"rgb(52,211,153)\" opacity=\"0\" filter=\"url(#pktGlow)\"><animateMotion dur=\"2.0s\" repeatCount=\"indefinite\" begin=\"0.7s\" path=\"M700,210 L465,210\"/></circle>\n            <circle class=\"after-packet\" r=\"2.5\" fill=\"rgb(52,211,153)\" opacity=\"0\" filter=\"url(#pktGlow)\"><animateMotion dur=\"2.6s\" repeatCount=\"indefinite\" begin=\"1.3s\" path=\"M465,230 L700,315\"/></circle>\n            <defs><filter id=\"pktGlow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\"><feGaussianBlur stdDeviation=\"3\" result=\"blur\"/><feMerge><feMergeNode in=\"blur\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter></defs>\n          </svg>\n    \n          <!-- Desktop infra nodes -->\n          <div class=\"infra-node absolute flex flex-col items-center gap-2\" style=\"left: 5%; top: 50px;\" id=\"nodeDb\">\n            <div class=\"w-14 h-14 rounded-xl flex items-center justify-center border border-orange-400/20 bg-orange-400/[0.06]\">\n              <svg class=\"w-5 h-5 text-orange-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"/><path d=\"M21 12c0 1.66-4 3-9 3s-9-1.34-9-3\"/><path d=\"M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5\"/></svg>\n            </div>\n            <span class=\"text-[11px] font-medium text-white/40 tracking-wide\">Database</span>\n          </div>\n          <div class=\"infra-node absolute flex flex-col items-center gap-2\" style=\"left: 20%; top: 140px;\" id=\"nodeAuth\">\n            <div class=\"w-14 h-14 rounded-xl flex items-center justify-center border border-purple-400/20 bg-purple-400/[0.06]\">\n              <svg class=\"w-5 h-5 text-purple-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/></svg>\n            </div>\n            <span class=\"text-[11px] font-medium text-white/40 tracking-wide\">Auth</span>\n          </div>\n          <div class=\"infra-node absolute flex flex-col items-center gap-2\" style=\"left: 5%; top: 230px;\" id=\"nodeApi\">\n            <div class=\"w-14 h-14 rounded-xl flex items-center justify-center border border-blue-400/20 bg-blue-400/[0.06]\">\n              <svg class=\"w-5 h-5 text-blue-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"16 18 22 12 16 6\"/><polyline points=\"8 6 2 12 8 18\"/></svg>\n            </div>\n            <span class=\"text-[11px] font-medium text-white/40 tracking-wide\">API</span>\n          </div>\n          <div class=\"infra-node absolute flex flex-col items-center gap-2\" style=\"left: 20%; top: 310px;\" id=\"nodeHost\">\n            <div class=\"w-14 h-14 rounded-xl flex items-center justify-center border border-pink-400/20 bg-pink-400/[0.06]\">\n              <svg class=\"w-5 h-5 text-pink-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"/><rect x=\"2\" y=\"14\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"/><line x1=\"6\" y1=\"6\" x2=\"6.01\" y2=\"6\"/><line x1=\"6\" y1=\"18\" x2=\"6.01\" y2=\"18\"/></svg>\n            </div>\n            <span class=\"text-[11px] font-medium text-white/40 tracking-wide\">Hosting</span>\n          </div>\n          <div class=\"infra-node absolute flex flex-col items-center gap-2\" style=\"left: 36%; top: 80px;\" id=\"nodeLogs\">\n            <div class=\"w-14 h-14 rounded-xl flex items-center justify-center border border-yellow-400/20 bg-yellow-400/[0.06]\">\n              <svg class=\"w-5 h-5 text-yellow-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/></svg>\n            </div>\n            <span class=\"text-[11px] font-medium text-white/40 tracking-wide\">Logs</span>\n          </div>\n          <div class=\"infra-node absolute flex flex-col items-center gap-2\" style=\"left: 36%; top: 270px;\" id=\"nodeCrud\">\n            <div class=\"w-14 h-14 rounded-xl flex items-center justify-center border border-teal-400/20 bg-teal-400/[0.06]\">\n              <svg class=\"w-5 h-5 text-teal-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"/></svg>\n            </div>\n            <span class=\"text-[11px] font-medium text-white/40 tracking-wide\">CRUD</span>\n          </div>\n          <div class=\"infra-node absolute flex flex-col items-center gap-2\" style=\"right: 12%; top: 170px;\" id=\"nodeYou\">\n            <div class=\"relative w-16 h-16 rounded-full border-2 border-dashed border-white/[0.12] flex items-center justify-center\">\n              <div class=\"stress-mark\"></div><div class=\"stress-mark\"></div><div class=\"stress-mark\"></div>\n              <span class=\"text-[11px] font-semibold text-white/35\">You</span>\n            </div>\n            <span class=\"text-[9px] uppercase tracking-[0.12em] text-white/50\">Managing it all</span>\n          </div>\n    \n          <!-- Desktop URL hub + clients (After state) -->\n          <div class=\"absolute flex flex-col items-center\" style=\"left: 50%; top: 50%; transform: translate(-65%, -50%); opacity: 0; transition: all 1.1s cubic-bezier(0.4,0,0.1,1);\" id=\"urlHub\">\n            <div class=\"relative\">\n              <div class=\"glow-ring\"></div><div class=\"glow-ring\"></div><div class=\"glow-ring\"></div>\n              <div class=\"diagram-glow relative rounded-2xl border border-emerald-400/25 bg-emerald-500/[0.05] px-6 py-4 md:px-8 md:py-5\">\n                <div class=\"font-mono text-sm md:text-[15px] font-semibold text-emerald-300 tracking-tight\">reqres.in/api/<span class=\"text-emerald-400\">your-project</span></div>\n              </div>\n            </div>\n            <div class=\"mt-4 text-center text-[12px] text-white/50 leading-relaxed\">Database · Auth · CRUD · Hosting · Logs<br><span class=\"text-white/45\">All handled. One URL.</span></div>\n            <div class=\"flex flex-wrap justify-center gap-1.5 mt-4 max-w-xs\">\n              <span class=\"text-[9px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">Postgres</s> ✓</span>\n              <span class=\"text-[9px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">OAuth</s> ✓</span>\n              <span class=\"text-[9px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">Express</s> ✓</span>\n              <span class=\"text-[9px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">AWS</s> ✓</span>\n              <span class=\"text-[9px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">Datadog</s> ✓</span>\n              <span class=\"text-[9px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">Routes</s> ✓</span>\n            </div>\n          </div>\n    \n          <div class=\"client-node absolute flex items-center gap-3\" style=\"right: 8%; top: 75px; opacity: 0;\" id=\"clientIos\">\n            <div class=\"w-11 h-11 rounded-xl flex items-center justify-center border border-emerald-400/15 bg-emerald-500/[0.05]\">\n              <svg class=\"w-4 h-4 text-emerald-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"2\" ry=\"2\"/><line x1=\"12\" y1=\"18\" x2=\"12.01\" y2=\"18\"/></svg>\n            </div>\n            <div><div class=\"text-[11px] font-medium text-white/50\">iOS App</div><div class=\"text-[9px] font-mono text-emerald-400/40 mt-0.5\">fetch(url)</div></div>\n          </div>\n          <div class=\"client-node absolute flex items-center gap-3\" style=\"right: 8%; top: 185px; opacity: 0;\" id=\"clientReact\">\n            <div class=\"w-11 h-11 rounded-xl flex items-center justify-center border border-emerald-400/15 bg-emerald-500/[0.05]\">\n              <svg class=\"w-4 h-4 text-emerald-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"/><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/></svg>\n            </div>\n            <div><div class=\"text-[11px] font-medium text-white/50\">React App</div><div class=\"text-[9px] font-mono text-emerald-400/40 mt-0.5\">fetch(url)</div></div>\n          </div>\n          <div class=\"client-node absolute flex items-center gap-3\" style=\"right: 8%; top: 295px; opacity: 0;\" id=\"clientAny\">\n            <div class=\"w-11 h-11 rounded-xl flex items-center justify-center border border-emerald-400/15 bg-emerald-500/[0.05]\">\n              <svg class=\"w-4 h-4 text-emerald-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"/><line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"/><line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"/></svg>\n            </div>\n            <div><div class=\"text-[11px] font-medium text-white/50\">Any Frontend</div><div class=\"text-[9px] font-mono text-emerald-400/40 mt-0.5\">fetch(url)</div></div>\n          </div>\n        </div>\n    \n        <!-- ═══ MOBILE DIAGRAM (< md) ═══ -->\n        <div data-reveal class=\"md:hidden rounded-2xl border border-white/[0.06] bg-white/[0.015] px-5 py-6\" id=\"diagramMobile\">\n    \n          <!-- BEFORE: scattered infra grid -->\n          <div class=\"mobile-before\" id=\"mobileBefore\">\n            <div class=\"grid grid-cols-3 gap-3 mb-5\">\n              <div class=\"infra-node-m flex flex-col items-center gap-1.5 py-3 rounded-xl border border-orange-400/15 bg-orange-400/[0.04]\">\n                <svg class=\"w-5 h-5 text-orange-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"/><path d=\"M21 12c0 1.66-4 3-9 3s-9-1.34-9-3\"/><path d=\"M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5\"/></svg>\n                <span class=\"text-[10px] text-white/35\">Database</span>\n              </div>\n              <div class=\"infra-node-m flex flex-col items-center gap-1.5 py-3 rounded-xl border border-purple-400/15 bg-purple-400/[0.04]\">\n                <svg class=\"w-5 h-5 text-purple-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/></svg>\n                <span class=\"text-[10px] text-white/35\">Auth</span>\n              </div>\n              <div class=\"infra-node-m flex flex-col items-center gap-1.5 py-3 rounded-xl border border-blue-400/15 bg-blue-400/[0.04]\">\n                <svg class=\"w-5 h-5 text-blue-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"16 18 22 12 16 6\"/><polyline points=\"8 6 2 12 8 18\"/></svg>\n                <span class=\"text-[10px] text-white/35\">API</span>\n              </div>\n              <div class=\"infra-node-m flex flex-col items-center gap-1.5 py-3 rounded-xl border border-pink-400/15 bg-pink-400/[0.04]\">\n                <svg class=\"w-5 h-5 text-pink-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"/><rect x=\"2\" y=\"14\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"/><line x1=\"6\" y1=\"6\" x2=\"6.01\" y2=\"6\"/><line x1=\"6\" y1=\"18\" x2=\"6.01\" y2=\"18\"/></svg>\n                <span class=\"text-[10px] text-white/35\">Hosting</span>\n              </div>\n              <div class=\"infra-node-m flex flex-col items-center gap-1.5 py-3 rounded-xl border border-yellow-400/15 bg-yellow-400/[0.04]\">\n                <svg class=\"w-5 h-5 text-yellow-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/></svg>\n                <span class=\"text-[10px] text-white/35\">Logs</span>\n              </div>\n              <div class=\"infra-node-m flex flex-col items-center gap-1.5 py-3 rounded-xl border border-teal-400/15 bg-teal-400/[0.04]\">\n                <svg class=\"w-5 h-5 text-teal-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"/></svg>\n                <span class=\"text-[10px] text-white/35\">CRUD</span>\n              </div>\n            </div>\n            <!-- Dashed lines converging on \"You\" -->\n            <div class=\"flex justify-center mb-2\">\n              <svg width=\"40\" height=\"24\" class=\"text-white/10\"><line x1=\"0\" y1=\"0\" x2=\"20\" y2=\"24\" stroke=\"currentColor\" stroke-width=\"1\" stroke-dasharray=\"2 2\"/><line x1=\"40\" y1=\"0\" x2=\"20\" y2=\"24\" stroke=\"currentColor\" stroke-width=\"1\" stroke-dasharray=\"2 2\"/></svg>\n            </div>\n            <div class=\"flex justify-center\">\n              <div class=\"relative w-14 h-14 rounded-full border-2 border-dashed border-white/[0.10] flex items-center justify-center\">\n                <div class=\"stress-mark\"></div><div class=\"stress-mark\"></div><div class=\"stress-mark\"></div>\n                <span class=\"text-[10px] font-semibold text-white/50\">You</span>\n              </div>\n            </div>\n            <p class=\"text-center text-[10px] text-white/15 mt-2 uppercase tracking-[0.1em]\">Managing it all</p>\n          </div>\n    \n          <!-- AFTER: clean vertical flow -->\n          <div class=\"mobile-after\" id=\"mobileAfter\" style=\"display: none;\">\n            <!-- URL Hub -->\n            <div class=\"flex justify-center mb-5\">\n              <div class=\"relative\">\n                <div class=\"glow-ring\" style=\"inset: -10px; border-radius: 18px;\"></div>\n                <div class=\"glow-ring\" style=\"inset: -22px; border-radius: 24px;\"></div>\n                <div class=\"diagram-glow relative rounded-xl border border-emerald-400/25 bg-emerald-500/[0.05] px-5 py-3\">\n                  <div class=\"font-mono text-[13px] font-semibold text-emerald-300 tracking-tight text-center\">reqres.in/api/<span class=\"text-emerald-400\">your-project</span></div>\n                </div>\n              </div>\n            </div>\n    \n            <p class=\"text-center text-[11px] text-white/50 leading-relaxed mb-4\">Database · Auth · CRUD · Hosting · Logs<br><span class=\"text-white/40\">All handled. One URL.</span></p>\n    \n            <!-- Arrow down -->\n            <div class=\"flex justify-center mb-4\">\n              <svg width=\"2\" height=\"28\" class=\"text-emerald-400/20\"><line x1=\"1\" y1=\"0\" x2=\"1\" y2=\"28\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-dasharray=\"4 3\"/></svg>\n            </div>\n    \n            <!-- Client apps row -->\n            <div class=\"grid grid-cols-3 gap-2\">\n              <div class=\"flex flex-col items-center gap-1.5 py-3 rounded-xl border border-emerald-400/10 bg-emerald-500/[0.03]\">\n                <svg class=\"w-4 h-4 text-emerald-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"2\" width=\"14\" height=\"20\" rx=\"2\" ry=\"2\"/><line x1=\"12\" y1=\"18\" x2=\"12.01\" y2=\"18\"/></svg>\n                <span class=\"text-[10px] text-white/45\">iOS</span>\n                <span class=\"text-[8px] font-mono text-emerald-400/35\">fetch()</span>\n              </div>\n              <div class=\"flex flex-col items-center gap-1.5 py-3 rounded-xl border border-emerald-400/10 bg-emerald-500/[0.03]\">\n                <svg class=\"w-4 h-4 text-emerald-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"/><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/></svg>\n                <span class=\"text-[10px] text-white/45\">React</span>\n                <span class=\"text-[8px] font-mono text-emerald-400/35\">fetch()</span>\n              </div>\n              <div class=\"flex flex-col items-center gap-1.5 py-3 rounded-xl border border-emerald-400/10 bg-emerald-500/[0.03]\">\n                <svg class=\"w-4 h-4 text-emerald-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"/><line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"/><line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"/></svg>\n                <span class=\"text-[10px] text-white/45\">Any app</span>\n                <span class=\"text-[8px] font-mono text-emerald-400/35\">fetch()</span>\n              </div>\n            </div>\n    \n            <!-- Badges -->\n            <div class=\"flex flex-wrap justify-center gap-1.5 mt-4\">\n              <span class=\"text-[8px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">Postgres</s> ✓</span>\n              <span class=\"text-[8px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">OAuth</s> ✓</span>\n              <span class=\"text-[8px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">Express</s> ✓</span>\n              <span class=\"text-[8px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">AWS</s> ✓</span>\n              <span class=\"text-[8px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">Datadog</s> ✓</span>\n              <span class=\"text-[8px] font-mono px-2 py-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] text-white/25\"><s class=\"decoration-white/45\">Routes</s> ✓</span>\n            </div>\n          </div>\n    \n        </div>\n    \n        <p data-reveal class=\"mt-6 md:mt-8 text-center text-sm sm:text-[15px] text-white/40 leading-relaxed\" id=\"diagramTagline\">\n          <span class=\"text-white/65 font-medium\">80% of backends</span> are CRUD + auth.<br>That's a lot of infra you're maintaining for nothing.\n        </p>\n      </div>\n    </section>\n    \n    <script>\n    (function() {\n      const btns = document.querySelectorAll('#diagramToggle button');\n      const tagline = document.getElementById('diagramTagline');\n    \n      // Desktop elements\n      const infraNodes = document.querySelectorAll('#diagramDesktop .infra-node');\n      const clientNodes = document.querySelectorAll('#diagramDesktop .client-node');\n      const urlHub = document.getElementById('urlHub');\n      const beforeLines = document.querySelectorAll('.before-line');\n      const youLines = document.querySelectorAll('.you-line');\n      const afterLines = document.querySelectorAll('.after-line');\n      const afterDots = document.querySelectorAll('.after-dot');\n      const afterPackets = document.querySelectorAll('.after-packet');\n    \n      // Mobile elements\n      const mobileBefore = document.getElementById('mobileBefore');\n      const mobileAfter = document.getElementById('mobileAfter');\n    \n      let currentPhase = 'before';\n      let autoTimer = null;\n      let userInteracted = false;\n      let sectionVisible = false;\n    \n      const prefersReducedMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n      const desktopSvg = document.querySelector('#diagramDesktop svg');\n    \n      const startAuto = () => {\n        if (autoTimer || prefersReducedMotion || userInteracted || !sectionVisible || document.hidden) return;\n        autoTimer = setInterval(() => { setPhase(currentPhase === 'before' ? 'with' : 'before'); }, 4500);\n      };\n      const stopAuto = () => {\n        if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }\n      };\n      const pauseSmil = () => { if (desktopSvg && desktopSvg.pauseAnimations) desktopSvg.pauseAnimations(); };\n      const resumeSmil = () => { if (desktopSvg && desktopSvg.unpauseAnimations) desktopSvg.unpauseAnimations(); };\n    \n      // Store original desktop positions\n      const origPos = {};\n      infraNodes.forEach(n => { origPos[n.id] = { left: n.style.left, top: n.style.top, right: n.style.right }; });\n    \n      function setPhase(phase) {\n        currentPhase = phase;\n        btns.forEach(b => {\n          const active = b.dataset.phase === phase;\n          b.className = 'phase-btn text-[10px] uppercase tracking-[0.14em] font-semibold px-4 py-1.5 rounded-md border cursor-pointer '\n            + (active ? 'border-emerald-400/25 bg-emerald-500/[0.06] text-emerald-300' : 'border-white/[0.08] bg-transparent text-white/50');\n        });\n    \n        // ── Desktop ──\n        if (phase === 'before') {\n          infraNodes.forEach(n => {\n            const o = origPos[n.id];\n            if (o.left) n.style.left = o.left;\n            if (o.top) n.style.top = o.top;\n            if (o.right) n.style.right = o.right;\n            n.style.opacity = '1';\n            n.style.transform = '';\n          });\n          beforeLines.forEach(l => l.setAttribute('stroke-opacity', '0.04'));\n          youLines.forEach(l => l.setAttribute('stroke-opacity', '0.03'));\n          afterLines.forEach(l => l.setAttribute('stroke-opacity', '0'));\n          afterDots.forEach(d => d.setAttribute('opacity', '0'));\n          afterPackets.forEach(p => p.setAttribute('opacity', '0'));\n          clientNodes.forEach(n => n.style.opacity = '0');\n          urlHub.style.opacity = '0';\n        } else {\n          infraNodes.forEach(n => {\n            n.style.opacity = '0';\n            n.style.transform = 'scale(0.3)';\n            n.style.left = '42%';\n            n.style.top = '42%';\n            n.style.right = 'auto';\n          });\n          beforeLines.forEach(l => l.setAttribute('stroke-opacity', '0'));\n          youLines.forEach(l => l.setAttribute('stroke-opacity', '0'));\n          afterLines.forEach(l => l.setAttribute('stroke-opacity', '0.15'));\n          afterDots.forEach(d => d.setAttribute('opacity', '1'));\n          afterPackets.forEach(p => p.setAttribute('opacity', '0.8'));\n          clientNodes.forEach((n, i) => { setTimeout(() => { n.style.opacity = '1'; }, 200 + i * 120); });\n          urlHub.style.opacity = '1';\n        }\n    \n        // ── Mobile ──\n        if (phase === 'before') {\n          mobileBefore.style.display = '';\n          mobileAfter.style.display = 'none';\n        } else {\n          mobileBefore.style.display = 'none';\n          mobileAfter.style.display = '';\n        }\n    \n        // ── Tagline ──\n        if (phase === 'before') {\n          tagline.innerHTML = '<span class=\"text-white/65 font-medium\">80% of backends</span> are CRUD + auth.<br>That\\'s a lot of infra you\\'re maintaining for nothing.';\n        } else {\n          tagline.innerHTML = '<span class=\"text-white/65 font-medium\">Database, auth, CRUD, hosting</span> - handled.<br>Just send requests.';\n        }\n      }\n    \n      btns.forEach(b => b.addEventListener('click', () => {\n        userInteracted = true;\n        stopAuto();\n        setPhase(b.dataset.phase);\n      }));\n      setPhase('before');\n    \n      const section = document.getElementById('how');\n      if (section && 'IntersectionObserver' in window) {\n        const io = new IntersectionObserver((entries) => {\n          entries.forEach(entry => {\n            sectionVisible = entry.isIntersecting;\n            if (sectionVisible) { resumeSmil(); startAuto(); }\n            else { pauseSmil(); stopAuto(); }\n          });\n        }, { threshold: 0.1 });\n        io.observe(section);\n      } else {\n        sectionVisible = true;\n        startAuto();\n      }\n    \n      document.addEventListener('visibilitychange', () => {\n        if (document.hidden) { pauseSmil(); stopAuto(); }\n        else if (sectionVisible) { resumeSmil(); startAuto(); }\n      });\n    })();\n    </script>\n    \n    <!-- ═══ END DROP-IN SECTION ═══ -->\n    <!-- ═══ INTERACTIVE TERMINAL WIDGET ═══ -->\n    \n    <style>\n      /* Terminal font - JetBrains Mono loaded via <link> in layout.html */\n      .terminal-font {\n        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n      }\n    \n      /* Cursor blink */\n      @keyframes terminalBlink {\n        0%, 50% { opacity: 1; }\n        51%, 100% { opacity: 0; }\n      }\n      .terminal-cursor {\n        display: inline-block;\n        width: 8px;\n        height: 16px;\n        background: #22C55E;\n        margin-left: 2px;\n        vertical-align: middle;\n        animation: terminalBlink 0.8s step-end infinite;\n      }\n    \n      /* Boot line animation */\n      @keyframes bootLineIn {\n        from { opacity: 0; transform: translateY(4px); }\n        to { opacity: 1; transform: translateY(0); }\n      }\n      .boot-line {\n        opacity: 0;\n        animation: bootLineIn 0.1s ease forwards;\n      }\n    \n      /* Checklist item */\n      .checklist-item {\n        display: flex;\n        align-items: center;\n        gap: 0.5rem;\n        padding-left: 1rem;\n        opacity: 0;\n        animation: bootLineIn 0.15s ease forwards;\n      }\n      .checklist-item .checkbox {\n        color: rgba(255, 255, 255, 0.4);\n      }\n      .checklist-item .text {\n        color: rgba(255, 255, 255, 0.7);\n        transition: all 0.15s ease;\n      }\n      .checklist-item.struck .text {\n        text-decoration: line-through;\n        opacity: 0.3;\n      }\n      .checklist-item.struck .checkbox {\n        opacity: 0.3;\n      }\n    \n      /* Arrow bounce animation */\n      @keyframes arrowBounce {\n        0%, 100% { transform: translateY(0); }\n        50% { transform: translateY(3px); }\n      }\n      .arrow-bounce {\n        display: inline-block;\n        animation: arrowBounce 1s ease-in-out infinite;\n      }\n    \n      /* Method pills */\n      .method-pill {\n        padding: 0.375rem 0.875rem;\n        border-radius: 0.5rem;\n        border: 1px solid rgba(255, 255, 255, 0.08);\n        background: rgba(255, 255, 255, 0.02);\n        color: rgba(255, 255, 255, 0.5);\n        font-size: 0.75rem;\n        font-weight: 600;\n        font-family: 'JetBrains Mono', monospace;\n        transition: all 0.2s ease;\n        cursor: pointer;\n      }\n      .method-pill:hover {\n        border-color: rgba(255, 255, 255, 0.15);\n        color: rgba(255, 255, 255, 0.7);\n      }\n      .method-pill:focus-visible {\n        outline: none;\n        box-shadow: 0 0 0 2px rgba(52, 211, 153, 0.5);\n      }\n      .method-pill.active[data-method=\"GET\"] {\n        background: rgba(59, 130, 246, 0.12);\n        border-color: rgba(59, 130, 246, 0.35);\n        color: #60A5FA;\n      }\n      .method-pill.active[data-method=\"POST\"] {\n        background: rgba(52, 211, 153, 0.12);\n        border-color: rgba(52, 211, 153, 0.35);\n        color: #34D399;\n      }\n      .method-pill.active[data-method=\"PUT\"] {\n        background: rgba(251, 191, 36, 0.12);\n        border-color: rgba(251, 191, 36, 0.35);\n        color: #FBBF24;\n      }\n      .method-pill.active[data-method=\"DELETE\"] {\n        background: rgba(239, 68, 68, 0.12);\n        border-color: rgba(239, 68, 68, 0.35);\n        color: #F87171;\n      }\n    \n      /* GET pill pulse animation for nudge */\n      @keyframes getPulse {\n        0%, 100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }\n        50% { box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.3); }\n      }\n      .method-pill.pulse-get {\n        animation: getPulse 1s ease-in-out 3;\n      }\n    \n      /* Audience toggle */\n      .audience-btn {\n        padding: 0.5rem 1rem;\n        border-radius: 0.5rem;\n        font-size: 0.8125rem;\n        font-weight: 500;\n        color: rgba(255, 255, 255, 0.5);\n        transition: all 0.2s ease;\n        cursor: pointer;\n        background: transparent;\n        border: none;\n      }\n      .audience-btn:hover {\n        color: rgba(255, 255, 255, 0.7);\n      }\n      .audience-btn:focus-visible {\n        outline: none;\n        box-shadow: 0 0 0 2px rgba(52, 211, 153, 0.5);\n      }\n      .audience-btn.active {\n        background: rgba(52, 211, 153, 0.1);\n        color: #34D399;\n      }\n    \n      /* Status badges */\n      .status-badge {\n        display: inline-flex;\n        align-items: center;\n        padding: 0.25rem 0.625rem;\n        border-radius: 0.375rem;\n        font-size: 0.75rem;\n        font-weight: 500;\n        font-family: 'JetBrains Mono', monospace;\n      }\n      .status-success {\n        background: rgba(52, 211, 153, 0.15);\n        border: 1px solid rgba(52, 211, 153, 0.25);\n        color: #34D399;\n      }\n      .status-error {\n        background: rgba(239, 68, 68, 0.15);\n        border: 1px solid rgba(239, 68, 68, 0.25);\n        color: #F87171;\n      }\n      .status-neutral {\n        background: rgba(255, 255, 255, 0.08);\n        border: 1px solid rgba(255, 255, 255, 0.12);\n        color: rgba(255, 255, 255, 0.7);\n      }\n    \n      /* JSON syntax highlighting */\n      .json-key { color: #E2E8F0; }\n      .json-string { color: #34D399; }\n      .json-number { color: #67E8F9; }\n      .json-boolean { color: #FBBF24; }\n      .json-null { color: rgba(255, 255, 255, 0.4); }\n      .json-bracket { color: rgba(255, 255, 255, 0.5); }\n    \n      /* Code editor with syntax highlighting */\n      .code-editor-wrapper {\n        position: relative;\n        border-radius: 0.5rem;\n        border: 1px solid rgba(255, 255, 255, 0.08);\n        background: rgba(0, 0, 0, 0.4);\n        overflow: hidden;\n      }\n      .code-editor-wrapper:focus-within {\n        border-color: rgba(52, 211, 153, 0.4);\n      }\n      .code-editor-highlight {\n        position: absolute;\n        top: 0;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        padding: 0.625rem 0.75rem;\n        font-size: 13px;\n        line-height: 1.5;\n        font-family: 'JetBrains Mono', ui-monospace, monospace;\n        white-space: pre-wrap;\n        word-wrap: break-word;\n        pointer-events: none;\n        overflow: hidden;\n      }\n      .code-editor-textarea {\n        position: relative;\n        width: 100%;\n        height: 7rem;\n        padding: 0.625rem 0.75rem;\n        font-size: 13px;\n        line-height: 1.5;\n        font-family: 'JetBrains Mono', ui-monospace, monospace;\n        color: transparent;\n        caret-color: #34D399;\n        background: transparent;\n        border: none;\n        resize: none;\n        outline: none;\n        white-space: pre-wrap;\n        word-wrap: break-word;\n      }\n      .code-editor-textarea::selection {\n        background: rgba(52, 211, 153, 0.3);\n      }\n    \n      /* CTA slide in */\n      @keyframes ctaSlideIn {\n        from { opacity: 0; transform: translateY(16px); }\n        to { opacity: 1; transform: translateY(0); }\n      }\n      .cta-banner-show {\n        animation: ctaSlideIn 0.4s ease forwards;\n      }\n    \n      /* Send button states */\n      @keyframes sendClick {\n        0% { transform: scale(1); }\n        50% { transform: scale(0.97); }\n        100% { transform: scale(1); }\n      }\n      .send-click {\n        animation: sendClick 0.1s ease;\n      }\n      @keyframes dotPulse {\n        0%, 80%, 100% { opacity: 0.3; }\n        40% { opacity: 1; }\n      }\n      .loading-dots span {\n        animation: dotPulse 1.2s ease-in-out infinite;\n      }\n      .loading-dots span:nth-child(2) { animation-delay: 0.2s; }\n      .loading-dots span:nth-child(3) { animation-delay: 0.4s; }\n    \n      /* Hint message - nudge prompt */\n      .nudge-prompt {\n        display: flex;\n        align-items: center;\n        gap: 0.5rem;\n        padding: 0.5rem 0.75rem;\n        margin-bottom: 0.75rem;\n        border-radius: 0.5rem;\n        border: 1px solid rgba(59, 130, 246, 0.25);\n        background: rgba(59, 130, 246, 0.08);\n        font-size: 0.8125rem;\n        color: #60A5FA;\n        cursor: pointer;\n        transition: all 0.2s ease;\n      }\n      .nudge-prompt:hover {\n        background: rgba(59, 130, 246, 0.12);\n        border-color: rgba(59, 130, 246, 0.35);\n      }\n      .nudge-prompt svg {\n        flex-shrink: 0;\n      }\n    \n      /* Explorer dimmed state during boot */\n      .explorer-dimmed {\n        opacity: 0.4;\n        pointer-events: none;\n      }\n      .explorer-active {\n        opacity: 1;\n        pointer-events: auto;\n        transition: opacity 0.3s ease;\n      }\n    \n      /* Content fade transition for audience toggle */\n      .content-fade {\n        transition: opacity 0.15s ease;\n      }\n    \n      /* Custom scrollbars for terminal */\n      #terminalWidget ::-webkit-scrollbar {\n        width: 8px;\n        height: 8px;\n      }\n      #terminalWidget ::-webkit-scrollbar-track {\n        background: transparent;\n      }\n      #terminalWidget ::-webkit-scrollbar-thumb {\n        background: rgba(255, 255, 255, 0.15);\n        border-radius: 4px;\n      }\n      #terminalWidget ::-webkit-scrollbar-thumb:hover {\n        background: rgba(255, 255, 255, 0.25);\n      }\n      #terminalWidget ::-webkit-scrollbar-corner {\n        background: transparent;\n      }\n      /* Firefox scrollbar */\n      #terminalWidget * {\n        scrollbar-width: thin;\n        scrollbar-color: rgba(255, 255, 255, 0.15) transparent;\n      }\n    \n      /* Reduced motion */\n      @media (prefers-reduced-motion: reduce) {\n        .boot-line,\n        .terminal-cursor,\n        .checklist-item,\n        .cta-banner-show,\n        .method-pill.pulse-get,\n        .arrow-bounce,\n        .send-click,\n        .loading-dots span {\n          animation: none !important;\n        }\n        .boot-line, .checklist-item { opacity: 1 !important; transform: none !important; }\n        .terminal-cursor { opacity: 1 !important; }\n        .arrow-bounce { transform: none !important; }\n      }\n    </style>\n    \n    <style>\n      /* Signed-in nudge (hidden by default). Shown only when layout.html's\n         detection script adds `rr-signed-in` to <html>. Points the user at\n         the real playground instead of this marketing-page demo. */\n      .rr-demo-signed-in-nudge { display: none; }\n      html.rr-signed-in .rr-demo-signed-in-nudge {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 0.75rem;\n        padding: 0.625rem 1rem;\n        margin-bottom: 1rem;\n        border-radius: 0.75rem;\n        border: 1px solid rgba(16, 185, 129, 0.25);\n        background: rgba(16, 185, 129, 0.06);\n        font-size: 0.875rem;\n      }\n      .rr-demo-signed-in-nudge .rr-signed-in-msg { color: rgba(255,255,255,0.8); }\n      .rr-demo-signed-in-nudge .rr-signed-in-cta {\n        color: #6ee7b7;\n        font-weight: 500;\n        text-decoration: none;\n        white-space: nowrap;\n      }\n      .rr-demo-signed-in-nudge .rr-signed-in-cta:hover { color: #a7f3d0; }\n    </style>\n    \n    <section class=\"py-12 md:py-16\" id=\"try-terminal\">\n      <div class=\"max-w-5xl mx-auto px-4 sm:px-6 lg:px-8\">\n    \n        <div class=\"rr-demo-signed-in-nudge\">\n          <span class=\"rr-signed-in-msg\">\n            You're signed in - this demo returns sample data.\n          </span>\n          <a href=\"https://app.reqres.in/playground\" class=\"rr-signed-in-cta\">\n            Open the real playground →\n          </a>\n        </div>\n    \n        <!-- Section Header -->\n        <div data-reveal class=\"text-center mb-6 md:mb-8\">\n          <div class=\"text-[11px] uppercase tracking-[0.18em] text-emerald-400/70 font-semibold mb-3\">\n            Try it now\n          </div>\n          <h2 class=\"text-2xl md:text-3xl font-semibold tracking-tight text-white mb-2\">\n            Your backend, live in your browser.\n          </h2>\n          <p class=\"text-sm text-white/50\">\n            No signup required. Just hit Send.\n          </p>\n        </div>\n    \n        <!-- Audience Toggle -->\n        <div data-reveal class=\"flex justify-center mb-4\" id=\"audienceToggle\">\n          <div class=\"inline-flex rounded-lg border border-white/[0.08] bg-white/[0.02] p-1\">\n            <button data-audience=\"testing\" class=\"audience-btn active\" type=\"button\">\n              I'm testing something\n            </button>\n            <button data-audience=\"building\" class=\"audience-btn\" type=\"button\">\n              I'm building something\n            </button>\n          </div>\n        </div>\n        <p id=\"audienceTagline\" data-reveal class=\"text-center text-sm text-white/55 mb-6 max-w-xl mx-auto content-fade\">\n          Predictable API responses for your test suite - Playwright, Cypress, or Postman.\n        </p>\n    \n        <!-- Terminal Container -->\n        <div data-reveal id=\"terminalWidget\" class=\"rounded-2xl border border-white/[0.06] bg-[#111217] overflow-hidden shadow-2xl shadow-black/30\">\n    \n          <!-- Terminal Header Bar -->\n          <div class=\"flex items-center gap-2 px-4 py-3 border-b border-white/[0.06] bg-white/[0.02]\">\n            <div class=\"flex gap-1.5\">\n              <span class=\"w-3 h-3 rounded-full\" style=\"background: #FF5F56;\"></span>\n              <span class=\"w-3 h-3 rounded-full\" style=\"background: #FFBD2E;\"></span>\n              <span class=\"w-3 h-3 rounded-full\" style=\"background: #27C93F;\"></span>\n            </div>\n            <span class=\"text-[11px] text-white/40 terminal-font ml-2\">reqres-terminal</span>\n          </div>\n    \n          <!-- Boot Sequence Container -->\n          <div id=\"bootSequence\" class=\"p-5 terminal-font text-sm leading-relaxed min-h-[220px]\">\n            <div id=\"bootLines\"></div>\n            <span id=\"bootCursor\" class=\"terminal-cursor\"></span>\n          </div>\n    \n          <!-- API Explorer Container (visible but dimmed during boot) -->\n          <div id=\"apiExplorer\" class=\"explorer-dimmed\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2\">\n    \n              <!-- Request Panel -->\n              <div class=\"border-b lg:border-b-0 lg:border-r border-white/[0.06] p-5\">\n                <div class=\"text-[11px] uppercase tracking-[0.15em] text-white/50 font-semibold mb-4\">Request</div>\n    \n                <!-- Nudge Prompt (hidden initially) -->\n                <div id=\"nudgePrompt\" class=\"hidden nudge-prompt\">\n                  <span id=\"nudgeText\">That's stored. Now fetch it back</span>\n                  <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                    <polyline points=\"9 18 15 12 9 6\"/>\n                  </svg>\n                </div>\n    \n                <!-- Method Pills -->\n                <div class=\"flex flex-wrap gap-2 mb-4\" id=\"methodPills\" role=\"group\" aria-label=\"HTTP Method\">\n                  <button data-method=\"GET\" class=\"method-pill\" type=\"button\">GET</button>\n                  <button data-method=\"POST\" class=\"method-pill active\" type=\"button\">POST</button>\n                  <button data-method=\"PUT\" class=\"method-pill\" type=\"button\">PUT</button>\n                  <button data-method=\"DELETE\" class=\"method-pill\" type=\"button\">DELETE</button>\n                </div>\n    \n                <!-- Endpoint Display -->\n                <div class=\"rounded-lg border border-white/[0.08] bg-black/30 px-3 py-2.5 mb-4 overflow-x-auto\">\n                  <code class=\"text-[13px] terminal-font whitespace-nowrap\">\n                    <span id=\"endpointBase\" class=\"text-white/40\">https://reqres.in/api/my-app/</span><span id=\"endpointPath\" class=\"text-emerald-400\">collections/todos/records</span>\n                  </code>\n                </div>\n    \n                <!-- JSON Body Editor with Syntax Highlighting -->\n                <div id=\"bodyEditorContainer\" class=\"mb-4\">\n                  <label for=\"requestBody\" class=\"block text-[10px] uppercase tracking-[0.12em] text-white/40 mb-2\">Body</label>\n                  <div class=\"code-editor-wrapper\">\n                    <pre id=\"requestBodyHighlight\" class=\"code-editor-highlight\" aria-hidden=\"true\"></pre>\n                    <textarea\n                      id=\"requestBody\"\n                      class=\"code-editor-textarea\"\n                      spellcheck=\"false\"\n                      aria-label=\"Request body JSON\"\n                    ></textarea>\n                  </div>\n                </div>\n    \n                <!-- Send Button -->\n                <button\n                  id=\"sendBtn\"\n                  type=\"button\"\n                  class=\"w-full py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-black font-semibold text-sm transition-colors flex items-center justify-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#111217]\"\n                >\n                  <span id=\"sendBtnText\">Send</span>\n                  <svg id=\"sendBtnArrow\" class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                    <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/>\n                    <polyline points=\"12 5 19 12 12 19\"/>\n                  </svg>\n                  <span id=\"sendBtnDots\" class=\"loading-dots hidden\">\n                    <span>.</span><span>.</span><span>.</span>\n                  </span>\n                </button>\n              </div>\n    \n              <!-- Response Panel -->\n              <div class=\"p-5\" aria-live=\"polite\" aria-atomic=\"true\">\n                <div class=\"text-[11px] uppercase tracking-[0.15em] text-white/50 font-semibold mb-4\">Response</div>\n    \n                <!-- Status Badge & Time -->\n                <div id=\"responseStatus\" class=\"flex items-center gap-3 mb-4 min-h-[28px]\">\n                  <!-- Populated dynamically -->\n                </div>\n    \n                <!-- Response Body -->\n                <pre id=\"responseBody\" class=\"rounded-lg border border-white/[0.08] bg-black/40 p-3 text-[13px] leading-relaxed terminal-font overflow-x-auto min-h-[120px] max-h-[280px] overflow-y-auto text-white/60\">// Response will appear here</pre>\n              </div>\n            </div>\n          </div>\n        </div>\n    \n        <!-- CTA Banner (hidden initially) -->\n        <div id=\"ctaBanner\" class=\"hidden mt-6\">\n          <div class=\"rounded-2xl border border-emerald-400/20 bg-emerald-400/[0.03] p-5 md:p-6 text-center\">\n            <p class=\"text-[15px] text-white/80 mb-2\">\n              That's a real backend. Yours is 30 seconds away.\n            </p>\n            <p class=\"text-[13px] text-white/50 mb-4\">\n              Database, API, and auth - from a URL. No code. No deploy.\n            </p>\n            <div class=\"flex flex-wrap justify-center gap-3\">\n              <a\n                href=\"https://app.reqres.in\"\n                class=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-black font-semibold text-sm transition-colors\"\n              >\n                Create your backend\n                <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <polyline points=\"9 18 15 12 9 6\"/>\n                </svg>\n              </a>\n              <a\n                href=\"https://app.reqres.in/examples/notes-app\"\n                class=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-white/10 text-white/70 hover:text-white hover:border-white/20 text-sm transition-colors\"\n              >\n                See example app\n              </a>\n            </div>\n          </div>\n        </div>\n    \n      </div>\n    </section>\n    \n    <script>\n    (function() {\n      'use strict';\n    \n      // Audience-specific configurations\n      const audienceConfig = {\n        building: {\n          tagline: 'Ship your frontend with a real backend - no Express, no Postgres, no deploy.',\n          projectName: 'my-app',\n          collectionName: 'todos',\n          defaultBody: {\n            title: 'Ship the frontend',\n            completed: false\n          },\n          nudgeText: \"That's stored. Now fetch it back\"\n        },\n        testing: {\n          tagline: 'Predictable API responses for your test suite - Playwright, Cypress, or Postman.',\n          projectName: 'test-suite',\n          collectionName: 'users',\n          defaultBody: {\n            name: 'Jane Doe',\n            email: 'jane@example.com',\n            role: 'admin'\n          },\n          nudgeText: 'Data persists between requests. Verify it'\n        }\n      };\n    \n      // Checklist items (what you're skipping)\n      const checklistItems = [\n        'Install & configure Postgres',\n        'Write API routes & controllers',\n        'Add authentication middleware',\n        'Set up hosting & deployment',\n        'Configure logging & monitoring'\n      ];\n    \n      // State\n      const state = {\n        phase: 'boot',\n        audience: 'testing',\n        method: 'POST',\n        records: [],\n        requestCount: 0,\n        bootComplete: false,\n        ctaShown: false,\n        isLoading: false,\n        hasInteracted: false\n      };\n    \n      // DOM elements (cached after DOMContentLoaded)\n      let elements = {};\n    \n      // Get current config\n      function getConfig() {\n        return audienceConfig[state.audience];\n      }\n    \n      // Utilities\n      function generateId() {\n        const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';\n        let id = 'rec_';\n        for (let i = 0; i < 8; i++) {\n          id += chars.charAt(Math.floor(Math.random() * chars.length));\n        }\n        return id;\n      }\n    \n      function sleep(ms) {\n        return new Promise(resolve => setTimeout(resolve, ms));\n      }\n    \n      function getTimestamp() {\n        return new Date().toISOString();\n      }\n    \n      // JSON syntax highlighting (for objects)\n      function highlightJSON(obj) {\n        if (obj === null) return '<span class=\"json-null\">null</span>';\n        if (obj === undefined) return '';\n    \n        const json = JSON.stringify(obj, null, 2);\n        return highlightJSONString(json);\n      }\n    \n      // JSON syntax highlighting (for raw strings)\n      function highlightJSONString(str) {\n        if (!str) return '';\n        return str\n          .replace(/&/g, '&amp;')\n          .replace(/</g, '&lt;')\n          .replace(/>/g, '&gt;')\n          .replace(/\"([^\"]+)\":/g, '<span class=\"json-key\">\"$1\"</span>:')\n          .replace(/: \"([^\"]*)\"(,?)/g, ': <span class=\"json-string\">\"$1\"</span>$2')\n          .replace(/: (-?\\d+\\.?\\d*)(,?)/g, ': <span class=\"json-number\">$1</span>$2')\n          .replace(/: (true|false)(,?)/g, ': <span class=\"json-boolean\">$1</span>$2')\n          .replace(/: (null)(,?)/g, ': <span class=\"json-null\">$1</span>$2')\n          .replace(/([{}\\[\\]])/g, '<span class=\"json-bracket\">$1</span>');\n      }\n    \n      // Update request body highlighting\n      function updateRequestBodyHighlight() {\n        if (elements.requestBodyHighlight && elements.requestBody) {\n          const value = elements.requestBody.value;\n          elements.requestBodyHighlight.innerHTML = highlightJSONString(value) + '\\n';\n        }\n      }\n    \n      // Boot sequence - \"what you're skipping\" framing\n      async function startBootSequence() {\n        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n        const config = getConfig();\n    \n        // Show boot sequence, keep explorer visible but dimmed\n        elements.bootSequence.style.display = 'block';\n        elements.apiExplorer.classList.remove('hidden');\n        elements.apiExplorer.classList.add('explorer-dimmed');\n        elements.apiExplorer.classList.remove('explorer-active');\n    \n        if (reduceMotion) {\n          showFinalBootState();\n          await sleep(300);\n          transitionToExplorer();\n          return;\n        }\n    \n        const bootLinesContainer = elements.bootLines;\n        const cursor = elements.bootCursor;\n    \n        // Phase 1: \"Setting up your backend the usual way...\" (0.6s)\n        const line1 = document.createElement('div');\n        line1.className = 'boot-line';\n        line1.innerHTML = '<span class=\"text-white/70\">> Setting up your backend the usual way...</span>';\n        bootLinesContainer.appendChild(line1);\n        bootLinesContainer.appendChild(cursor);\n        await sleep(600);\n    \n        // Phase 2: Checklist items (2s total = 0.4s each)\n        const checklistEls = [];\n        for (let i = 0; i < checklistItems.length; i++) {\n          const item = document.createElement('div');\n          item.className = 'checklist-item';\n          item.style.animationDelay = (i * 0.05) + 's';\n          item.innerHTML = `<span class=\"checkbox\">\\u25A1</span><span class=\"text\">${checklistItems[i]}</span>`;\n          bootLinesContainer.appendChild(item);\n          checklistEls.push(item);\n          await sleep(400);\n        }\n        bootLinesContainer.appendChild(cursor);\n    \n        // Phase 3: Pause then \"Actually... skip all that.\" with emphasis\n        await sleep(600);\n        const line2 = document.createElement('div');\n        line2.className = 'boot-line';\n        line2.innerHTML = '<span class=\"text-white/70\">> Actually... </span><span class=\"text-emerald-400\">skip all that.</span>';\n        bootLinesContainer.appendChild(line2);\n        bootLinesContainer.appendChild(cursor);\n    \n        // Hold on \"skip all that\" for emphasis\n        await sleep(1200);\n    \n        // Phase 4: Strike through cascade (~120ms each)\n        for (let i = 0; i < checklistEls.length; i++) {\n          checklistEls[i].classList.add('struck');\n          await sleep(120);\n        }\n    \n        // Pause after strikethrough completes\n        await sleep(400);\n    \n        // Phase 5: ReqRes lines\n        const line3 = document.createElement('div');\n        line3.className = 'boot-line';\n        line3.innerHTML = '<span class=\"text-emerald-400\">> reqres.in/api/' + config.projectName + ' \\u2713</span>';\n        bootLinesContainer.appendChild(line3);\n        await sleep(300);\n    \n        const line4 = document.createElement('div');\n        line4.className = 'boot-line';\n        line4.innerHTML = '<span class=\"text-emerald-400\">> Database, API, auth, logs - live.</span>';\n        bootLinesContainer.appendChild(line4);\n        await sleep(300);\n    \n        // Empty line\n        const emptyLine = document.createElement('div');\n        emptyLine.innerHTML = '&nbsp;';\n        bootLinesContainer.appendChild(emptyLine);\n    \n        const line5 = document.createElement('div');\n        line5.className = 'boot-line';\n        line5.innerHTML = '<span class=\"text-white/60\">> Try it <span class=\"arrow-bounce\">\\u2193</span></span>';\n        bootLinesContainer.appendChild(line5);\n        bootLinesContainer.appendChild(cursor);\n    \n        // Pause before transitioning to explorer\n        await sleep(1500);\n        transitionToExplorer();\n      }\n    \n      function showFinalBootState() {\n        const config = getConfig();\n        const bootLinesContainer = elements.bootLines;\n    \n        // Show struck checklist\n        const line1 = document.createElement('div');\n        line1.style.opacity = '1';\n        line1.innerHTML = '<span class=\"text-white/70\">> Setting up your backend the usual way...</span>';\n        bootLinesContainer.appendChild(line1);\n    \n        checklistItems.forEach(item => {\n          const el = document.createElement('div');\n          el.className = 'checklist-item struck';\n          el.style.opacity = '1';\n          el.innerHTML = `<span class=\"checkbox\">\\u25A1</span><span class=\"text\">${item}</span>`;\n          bootLinesContainer.appendChild(el);\n        });\n    \n        const line2 = document.createElement('div');\n        line2.style.opacity = '1';\n        line2.innerHTML = '<span class=\"text-white/70\">> Actually... </span><span class=\"text-emerald-400\">skip all that.</span>';\n        bootLinesContainer.appendChild(line2);\n    \n        const line3 = document.createElement('div');\n        line3.style.opacity = '1';\n        line3.innerHTML = '<span class=\"text-emerald-400\">> reqres.in/api/' + config.projectName + ' \\u2713</span>';\n        bootLinesContainer.appendChild(line3);\n    \n        const line4 = document.createElement('div');\n        line4.style.opacity = '1';\n        line4.innerHTML = '<span class=\"text-emerald-400\">> Database, API, auth, logs - live.</span>';\n        bootLinesContainer.appendChild(line4);\n    \n        const emptyLine = document.createElement('div');\n        emptyLine.innerHTML = '&nbsp;';\n        bootLinesContainer.appendChild(emptyLine);\n    \n        const line5 = document.createElement('div');\n        line5.style.opacity = '1';\n        line5.innerHTML = '<span class=\"text-white/60\">> Try it \\u2193</span>';\n        bootLinesContainer.appendChild(line5);\n    \n        elements.bootCursor.style.display = 'none';\n      }\n    \n      function transitionToExplorer() {\n        state.bootComplete = true;\n        state.phase = 'explorer';\n    \n        elements.bootSequence.style.display = 'none';\n        elements.apiExplorer.classList.remove('explorer-dimmed');\n        elements.apiExplorer.classList.add('explorer-active');\n    \n        // Set default body for current audience\n        const config = getConfig();\n        elements.requestBody.value = JSON.stringify(config.defaultBody, null, 2);\n        updateRequestBodyHighlight();\n    \n        // Update endpoint\n        updateEndpoint();\n    \n        // Set initial method\n        setMethod('POST');\n      }\n    \n      // Update endpoint display based on current audience and method\n      function updateEndpoint() {\n        const config = getConfig();\n        const basePath = 'https://reqres.in/api/' + config.projectName + '/';\n        elements.endpointBase.textContent = basePath;\n    \n        if (state.method === 'PUT' || state.method === 'DELETE') {\n          if (state.records.length > 0) {\n            elements.endpointPath.textContent = 'collections/' + config.collectionName + '/records/' + state.records[0].id;\n          } else {\n            elements.endpointPath.textContent = 'collections/' + config.collectionName + '/records/:id';\n          }\n        } else {\n          elements.endpointPath.textContent = 'collections/' + config.collectionName + '/records';\n        }\n      }\n    \n      // Method switching\n      function setMethod(method) {\n        state.method = method;\n    \n        // Update pills\n        document.querySelectorAll('.method-pill').forEach(pill => {\n          pill.classList.toggle('active', pill.dataset.method === method);\n          pill.classList.remove('pulse-get');\n        });\n    \n        // Show/hide body editor\n        const showBody = method === 'POST' || method === 'PUT';\n        elements.bodyEditorContainer.style.display = showBody ? 'block' : 'none';\n    \n        // Update endpoint\n        updateEndpoint();\n    \n        // Pre-fill PUT body\n        if (method === 'PUT' && state.records.length > 0) {\n          const record = state.records[0];\n          if (state.audience === 'building') {\n            elements.requestBody.value = JSON.stringify({\n              title: record.title,\n              completed: true\n            }, null, 2);\n          } else {\n            elements.requestBody.value = JSON.stringify({\n              name: record.name,\n              email: record.email,\n              role: 'superadmin'\n            }, null, 2);\n          }\n          updateRequestBodyHighlight();\n        } else if (method === 'POST') {\n          const config = getConfig();\n          elements.requestBody.value = JSON.stringify(config.defaultBody, null, 2);\n          updateRequestBodyHighlight();\n        }\n    \n        // Hide nudge prompt when switching to GET\n        if (method === 'GET') {\n          elements.nudgePrompt.classList.add('hidden');\n        }\n      }\n    \n      // API handlers with realistic response times\n      const apiHandlers = {\n        GET: () => {\n          const delay = 8 + Math.random() * 17; // 8-25ms\n          return {\n            status: 200,\n            statusText: '200 OK',\n            statusClass: 'status-success',\n            delay,\n            body: {\n              data: state.records,\n              total: state.records.length,\n              page: 1,\n              per_page: 20\n            }\n          };\n        },\n    \n        POST: (body) => {\n          const delay = 18 + Math.random() * 27; // 18-45ms\n          const record = {\n            id: generateId(),\n            ...body,\n            createdAt: getTimestamp(),\n            updatedAt: getTimestamp()\n          };\n          state.records.push(record);\n          return {\n            status: 201,\n            statusText: '201 Created',\n            statusClass: 'status-success',\n            delay,\n            body: record,\n            showNudge: state.requestCount === 0\n          };\n        },\n    \n        PUT: (body) => {\n          const delay = 15 + Math.random() * 25; // 15-40ms\n          if (state.records.length === 0) {\n            return {\n              status: 404,\n              statusText: '404 Not Found',\n              statusClass: 'status-error',\n              delay,\n              body: { error: 'No record found to update' }\n            };\n          }\n          const record = state.records[0];\n          Object.assign(record, body, { updatedAt: getTimestamp() });\n          return {\n            status: 200,\n            statusText: '200 OK',\n            statusClass: 'status-success',\n            delay,\n            body: record\n          };\n        },\n    \n        DELETE: () => {\n          const delay = 8 + Math.random() * 10; // 8-18ms\n          if (state.records.length === 0) {\n            return {\n              status: 404,\n              statusText: '404 Not Found',\n              statusClass: 'status-error',\n              delay,\n              body: { error: 'No record found to delete' }\n            };\n          }\n          state.records.shift();\n          return {\n            status: 204,\n            statusText: '204 No Content',\n            statusClass: 'status-neutral',\n            delay,\n            body: null\n          };\n        }\n      };\n    \n      // Send request\n      async function sendRequest() {\n        if (state.isLoading) return;\n    \n        state.isLoading = true;\n        state.hasInteracted = true;\n    \n        // Button animation\n        elements.sendBtn.classList.add('send-click');\n        setTimeout(() => elements.sendBtn.classList.remove('send-click'), 100);\n    \n        // Show loading dots\n        elements.sendBtnText.textContent = 'Sending';\n        elements.sendBtnArrow.classList.add('hidden');\n        elements.sendBtnDots.classList.remove('hidden');\n    \n        // Parse body if needed\n        let body = null;\n        if (state.method === 'POST' || state.method === 'PUT') {\n          try {\n            body = JSON.parse(elements.requestBody.value);\n          } catch (e) {\n            showResponse({\n              status: 400,\n              statusText: '400 Bad Request',\n              statusClass: 'status-error',\n              delay: 5,\n              body: { error: 'Invalid JSON in request body' }\n            });\n            resetSendButton();\n            return;\n          }\n        }\n    \n        const handler = apiHandlers[state.method];\n        const response = handler(body);\n    \n        // Simulate network delay (add 150ms base for realism)\n        await sleep(response.delay + 150);\n    \n        showResponse(response);\n        resetSendButton();\n    \n        state.requestCount++;\n    \n        // Show CTA after 2+ requests\n        if (state.requestCount >= 2 && !state.ctaShown) {\n          showCTA();\n        }\n      }\n    \n      function resetSendButton() {\n        state.isLoading = false;\n        elements.sendBtnText.textContent = 'Send';\n        elements.sendBtnArrow.classList.remove('hidden');\n        elements.sendBtnDots.classList.add('hidden');\n      }\n    \n      function showResponse(response) {\n        // Status badge\n        elements.responseStatus.innerHTML = `\n          <span class=\"status-badge ${response.statusClass}\">${response.statusText}</span>\n          <span class=\"text-[11px] text-white/40 terminal-font\">${Math.round(response.delay)}ms</span>\n        `;\n    \n        // Response body\n        if (response.body === null) {\n          elements.responseBody.innerHTML = '<span class=\"text-white/40\">// No content</span>';\n        } else {\n          elements.responseBody.innerHTML = highlightJSON(response.body);\n        }\n    \n        // Show nudge after first POST\n        if (response.showNudge) {\n          // Wait 1 second then show nudge\n          setTimeout(() => {\n            const config = getConfig();\n            elements.nudgePrompt.querySelector('#nudgeText').textContent = config.nudgeText;\n            elements.nudgePrompt.classList.remove('hidden');\n    \n            // Add pulse animation to GET pill\n            const getPill = document.querySelector('.method-pill[data-method=\"GET\"]');\n            if (getPill) {\n              getPill.classList.add('pulse-get');\n            }\n          }, 1000);\n        }\n      }\n    \n      function showCTA() {\n        state.ctaShown = true;\n        elements.ctaBanner.classList.remove('hidden');\n        elements.ctaBanner.classList.add('cta-banner-show');\n      }\n    \n      // Audience toggle\n      function setAudience(newAudience) {\n        if (newAudience === state.audience) return;\n    \n        state.audience = newAudience;\n    \n        // Update toggle buttons\n        document.querySelectorAll('.audience-btn').forEach(btn => {\n          btn.classList.toggle('active', btn.dataset.audience === newAudience);\n        });\n    \n        const config = getConfig();\n    \n        // Fade out tagline, update, fade in\n        elements.audienceTagline.style.opacity = '0';\n        setTimeout(() => {\n          elements.audienceTagline.textContent = config.tagline;\n          elements.audienceTagline.style.opacity = '1';\n        }, 150);\n    \n        // If boot is complete, update terminal content\n        if (state.bootComplete) {\n          // Reset state\n          state.records = [];\n          state.requestCount = 0;\n          state.ctaShown = false;\n          elements.ctaBanner.classList.add('hidden');\n          elements.ctaBanner.classList.remove('cta-banner-show');\n          elements.nudgePrompt.classList.add('hidden');\n    \n          // Remove pulse from GET pill\n          const getPill = document.querySelector('.method-pill[data-method=\"GET\"]');\n          if (getPill) getPill.classList.remove('pulse-get');\n    \n          // Smooth content transition if user has interacted\n          if (state.hasInteracted) {\n            // Fade out\n            elements.requestBody.style.opacity = '0';\n            elements.requestBodyHighlight.style.opacity = '0';\n            elements.responseBody.style.opacity = '0';\n    \n            setTimeout(() => {\n              // Update content\n              elements.requestBody.value = JSON.stringify(config.defaultBody, null, 2);\n              updateRequestBodyHighlight();\n              updateEndpoint();\n              elements.responseBody.innerHTML = '<span class=\"text-white/60\">// Response will appear here</span>';\n              elements.responseStatus.innerHTML = '';\n    \n              // Reset to POST\n              setMethod('POST');\n    \n              // Fade in\n              elements.requestBody.style.opacity = '1';\n              elements.requestBodyHighlight.style.opacity = '1';\n              elements.responseBody.style.opacity = '1';\n            }, 150);\n          } else {\n            // Instant update if no interaction yet\n            elements.requestBody.value = JSON.stringify(config.defaultBody, null, 2);\n            updateRequestBodyHighlight();\n            updateEndpoint();\n            setMethod('POST');\n          }\n        }\n      }\n    \n      // Initialize\n      function init() {\n        // Cache DOM elements\n        elements = {\n          terminalWidget: document.getElementById('terminalWidget'),\n          bootSequence: document.getElementById('bootSequence'),\n          bootLines: document.getElementById('bootLines'),\n          bootCursor: document.getElementById('bootCursor'),\n          apiExplorer: document.getElementById('apiExplorer'),\n          methodPills: document.getElementById('methodPills'),\n          requestBody: document.getElementById('requestBody'),\n          requestBodyHighlight: document.getElementById('requestBodyHighlight'),\n          bodyEditorContainer: document.getElementById('bodyEditorContainer'),\n          endpointBase: document.getElementById('endpointBase'),\n          endpointPath: document.getElementById('endpointPath'),\n          sendBtn: document.getElementById('sendBtn'),\n          sendBtnText: document.getElementById('sendBtnText'),\n          sendBtnArrow: document.getElementById('sendBtnArrow'),\n          sendBtnDots: document.getElementById('sendBtnDots'),\n          responseStatus: document.getElementById('responseStatus'),\n          responseBody: document.getElementById('responseBody'),\n          nudgePrompt: document.getElementById('nudgePrompt'),\n          ctaBanner: document.getElementById('ctaBanner'),\n          audienceTagline: document.getElementById('audienceTagline')\n        };\n    \n        if (!elements.terminalWidget) return;\n    \n        // Set initial content\n        const config = getConfig();\n        elements.requestBody.value = JSON.stringify(config.defaultBody, null, 2);\n        updateRequestBodyHighlight();\n    \n        // Method pill clicks\n        elements.methodPills.addEventListener('click', (e) => {\n          const pill = e.target.closest('.method-pill');\n          if (pill && !state.isLoading && state.bootComplete) {\n            setMethod(pill.dataset.method);\n          }\n        });\n    \n        // Send button click\n        elements.sendBtn.addEventListener('click', () => {\n          if (state.bootComplete) sendRequest();\n        });\n    \n        // Keyboard: Enter to send when focused on textarea\n        elements.requestBody.addEventListener('keydown', (e) => {\n          if (e.key === 'Enter' && (e.metaKey || e.ctrlKey) && state.bootComplete) {\n            e.preventDefault();\n            sendRequest();\n          }\n        });\n    \n        // Sync syntax highlighting with textarea input\n        elements.requestBody.addEventListener('input', updateRequestBodyHighlight);\n        elements.requestBody.addEventListener('scroll', () => {\n          if (elements.requestBodyHighlight) {\n            elements.requestBodyHighlight.scrollTop = elements.requestBody.scrollTop;\n            elements.requestBodyHighlight.scrollLeft = elements.requestBody.scrollLeft;\n          }\n        });\n    \n        // Nudge prompt click - switch to GET\n        elements.nudgePrompt.addEventListener('click', () => {\n          setMethod('GET');\n        });\n    \n        // Audience toggle\n        document.getElementById('audienceToggle').addEventListener('click', (e) => {\n          const btn = e.target.closest('.audience-btn');\n          if (btn) {\n            setAudience(btn.dataset.audience);\n          }\n        });\n    \n        // IntersectionObserver for boot trigger\n        const observer = new IntersectionObserver((entries) => {\n          entries.forEach(entry => {\n            if (entry.isIntersecting && !state.bootComplete) {\n              observer.unobserve(entry.target);\n              startBootSequence();\n            }\n          });\n        }, { threshold: 0.3 });\n    \n        observer.observe(elements.terminalWidget);\n      }\n    \n      // Run on DOM ready\n      if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', init);\n      } else {\n        init();\n      }\n    })();\n    </script>\n\n    <!-- ═══ CUSTOMER TESTIMONIALS ═══ -->\n    \n    <style>\n      .testimonial-quote {\n        position: relative;\n      }\n      .testimonial-quote::before {\n        content: '\"';\n        position: absolute;\n        top: -0.5rem;\n        left: -0.75rem;\n        font-size: 4rem;\n        line-height: 1;\n        font-family: Georgia, serif;\n        color: rgba(52, 211, 153, 0.12);\n        pointer-events: none;\n        user-select: none;\n      }\n      @media (min-width: 768px) {\n        .testimonial-quote::before {\n          top: -1rem;\n          left: -1.5rem;\n          font-size: 5rem;\n        }\n      }\n      /* Light logos (default) - grayscale on dark background */\n      .testimonial-logo {\n        filter: grayscale(100%) brightness(1.2);\n        opacity: 0.7;\n        transition: all 0.2s ease;\n      }\n      .testimonial-logo:hover {\n        filter: grayscale(0%) brightness(1);\n        opacity: 1;\n      }\n      /* Dark logos - invert to make visible on dark background */\n      .testimonial-logo.logo-dark {\n        filter: grayscale(100%) invert(1) brightness(1.2);\n        opacity: 0.8;\n      }\n      .testimonial-logo.logo-dark:hover {\n        filter: grayscale(0%) invert(1) brightness(1);\n        opacity: 1;\n      }\n      /* Multiple testimonials grid */\n      .testimonials-grid {\n        display: grid;\n        gap: 2rem;\n      }\n      @media (min-width: 768px) {\n        .testimonials-grid.multi {\n          grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n          gap: 2.5rem;\n        }\n      }\n      /* Staggered fade-in for multiple testimonials */\n      .testimonial-item {\n        opacity: 0;\n        transform: translateY(12px);\n        transition: opacity 0.5s ease, transform 0.5s ease;\n      }\n      .testimonial-item.revealed {\n        opacity: 1;\n        transform: translateY(0);\n      }\n      @media (prefers-reduced-motion: reduce) {\n        .testimonial-item {\n          opacity: 1;\n          transform: none;\n          transition: none;\n        }\n      }\n    </style>\n    \n    <section class=\"py-12 md:py-16\" id=\"testimonials\">\n      <div class=\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\">\n    \n        <!-- Optional section label -->\n        <div class=\"text-center mb-6 md:mb-8\">\n          <div class=\"text-[11px] uppercase tracking-[0.18em] text-white/40 font-semibold\">\n            What developers say\n          </div>\n        </div>\n    \n        <!-- Testimonials container -->\n        <div class=\"testimonials-grid \" id=\"testimonialsGrid\">\n          <div class=\"testimonial-item text-center\" data-testimonial-index=\"0\">\n            <!-- Quote -->\n            <blockquote class=\"testimonial-quote relative pl-2 md:pl-4\">\n              <p class=\"text-lg md:text-xl lg:text-[22px] leading-relaxed text-white/90 font-light italic\">\n                Using ReqRes is way faster - you don&#x27;t have to deploy, create schemas, or check versions. ReqRes already handles that for you.\n              </p>\n            </blockquote>\n    \n            <!-- Attribution -->\n            <div class=\"mt-6 flex flex-col items-center gap-3\">\n              <img\n                src=\"/img/logos/avenix_logo.png\"\n                alt=\"Avenix\"\n                class=\"testimonial-logo h-6 md:h-7 w-auto logo-dark\"\n                loading=\"lazy\"\n              />\n              <div class=\"text-sm text-white/50\">\n                <span class=\"text-white/60\">- Adrijan Mahmuti</span>,\n                <a\n                  href=\"https://avenix.dev\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  class=\"text-white/50 hover:text-emerald-400 transition-colors\"\n                >Avenix</a>\n              </div>\n            </div>\n          </div>\n        </div>\n    \n      </div>\n    </section>\n    \n    <script>\n    (function() {\n      'use strict';\n    \n      const grid = document.getElementById('testimonialsGrid');\n      if (!grid) return;\n    \n      const items = grid.querySelectorAll('.testimonial-item');\n      if (!items.length) return;\n    \n      // Check for reduced motion preference\n      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      if (reduceMotion) {\n        items.forEach(item => item.classList.add('revealed'));\n        return;\n      }\n    \n      // IntersectionObserver for fade-in\n      const observer = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n          if (entry.isIntersecting) {\n            const item = entry.target;\n            const index = parseInt(item.dataset.testimonialIndex, 10) || 0;\n            // Stagger animation for multiple testimonials\n            setTimeout(() => {\n              item.classList.add('revealed');\n            }, index * 120);\n            observer.unobserve(item);\n          }\n        });\n      }, { threshold: 0.2 });\n    \n      items.forEach(item => observer.observe(item));\n    })();\n    </script>\n\n    <section class=\"py-14 md:py-20\">\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6\">\n            <div class=\"space-y-2 text-center\">\n                <p class=\"text-[11px] uppercase tracking-[0.18em] text-white/50 font-semibold\">Built for you</p>\n                <h2 class=\"text-2xl md:text-3xl font-semibold tracking-tight\">What are you working on?</h2>\n                <p class=\"text-sm text-white/60\">ReqRes works differently depending on what you need. Find your path.</p>\n            </div>\n    \n            <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 md:gap-5 mt-8\">\n                <!-- QA Engineers -->\n                <a href=\"/for/qa-engineers\" class=\"group rounded-2xl border border-white/10 bg-white/[0.03] p-5 flex flex-col gap-3 hover:border-white/20 hover:-translate-y-1 transition duration-300\">\n                    <div class=\"w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center\">\n                        <svg class=\"w-5 h-5 text-amber-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z\" />\n                        </svg>\n                    </div>\n                    <div class=\"space-y-1\">\n                        <h3 class=\"text-sm font-semibold text-white group-hover:text-amber-300 transition\">For QA Engineers</h3>\n                        <p class=\"text-xs text-white/60 leading-relaxed\">Predictable data and logs for Playwright, Cypress, and CI.</p>\n                    </div>\n                    <span class=\"mt-auto text-xs text-amber-300 group-hover:text-white transition inline-flex items-center gap-1\">\n                        See the QA guide <span aria-hidden=\"true\">→</span>\n                    </span>\n                </a>\n    \n                <!-- Frontend Developers -->\n                <a href=\"/for/frontend-developers\" class=\"group rounded-2xl border border-white/10 bg-white/[0.03] p-5 flex flex-col gap-3 hover:border-white/20 hover:-translate-y-1 transition duration-300\">\n                    <div class=\"w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center\">\n                        <svg class=\"w-5 h-5 text-emerald-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5\" />\n                        </svg>\n                    </div>\n                    <div class=\"space-y-1\">\n                        <h3 class=\"text-sm font-semibold text-white group-hover:text-emerald-300 transition\">For Frontend Developers</h3>\n                        <p class=\"text-xs text-white/60 leading-relaxed\">Own the full stack without waiting on backend tickets.</p>\n                    </div>\n                    <span class=\"mt-auto text-xs text-emerald-300 group-hover:text-white transition inline-flex items-center gap-1\">\n                        See how it works <span aria-hidden=\"true\">→</span>\n                    </span>\n                </a>\n    \n                <!-- Educators -->\n                <a href=\"/for/educators\" class=\"group rounded-2xl border border-white/10 bg-white/[0.03] p-5 flex flex-col gap-3 hover:border-white/20 hover:-translate-y-1 transition duration-300\">\n                    <div class=\"w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center\">\n                        <svg class=\"w-5 h-5 text-purple-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5\" />\n                        </svg>\n                    </div>\n                    <div class=\"space-y-1\">\n                        <h3 class=\"text-sm font-semibold text-white group-hover:text-purple-300 transition\">For Educators</h3>\n                        <p class=\"text-xs text-white/60 leading-relaxed\">Teach HTTP, auth, and REST without local setup friction.</p>\n                    </div>\n                    <span class=\"mt-auto text-xs text-purple-300 group-hover:text-white transition inline-flex items-center gap-1\">\n                        Set up a classroom <span aria-hidden=\"true\">→</span>\n                    </span>\n                </a>\n    \n                <!-- AI Agents -->\n                <a href=\"/for/ai-agents\" class=\"group rounded-2xl border border-emerald-400/20 bg-emerald-500/[0.03] p-5 flex flex-col gap-3 hover:border-emerald-400/40 hover:-translate-y-1 transition duration-300\">\n                    <div class=\"w-10 h-10 rounded-xl bg-emerald-500/15 flex items-center justify-center\">\n                        <svg class=\"w-5 h-5 text-emerald-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.847.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z\" />\n                        </svg>\n                    </div>\n                    <div class=\"space-y-1\">\n                        <div class=\"flex items-center gap-1.5\">\n                            <h3 class=\"text-sm font-semibold text-white group-hover:text-emerald-300 transition\">For AI Agents</h3>\n                            <span class=\"text-[10px] font-semibold text-emerald-400 bg-emerald-500/15 border border-emerald-400/25 rounded-full px-1.5 py-0.5\">New</span>\n                        </div>\n                        <p class=\"text-xs text-white/60 leading-relaxed\">A sandbox for Claude Code, Cursor, Copilot, and Devin.</p>\n                    </div>\n                    <span class=\"mt-auto text-xs text-emerald-300 group-hover:text-white transition inline-flex items-center gap-1\">\n                        Try /agent/v1 <span aria-hidden=\"true\">→</span>\n                    </span>\n                </a>\n    \n                <!-- Founders -->\n                <a href=\"/for/founders\" class=\"group rounded-2xl border border-white/10 bg-white/[0.03] p-5 flex flex-col gap-3 hover:border-white/20 hover:-translate-y-1 transition duration-300\">\n                    <div class=\"w-10 h-10 rounded-xl bg-indigo-500/10 flex items-center justify-center\">\n                        <svg class=\"w-5 h-5 text-indigo-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.63 8.37m5.96 6a14.926 14.926 0 01-5.84 2.58m0 0a14.926 14.926 0 01-5.96-6m5.96 6v4.8m-5.96-10.8a6 6 0 115.84 7.38\" />\n                        </svg>\n                    </div>\n                    <div class=\"space-y-1\">\n                        <h3 class=\"text-sm font-semibold text-white group-hover:text-indigo-300 transition\">For Founders</h3>\n                        <p class=\"text-xs text-white/60 leading-relaxed\">Ship MVPs and client-only SaaS without backend overhead.</p>\n                    </div>\n                    <span class=\"mt-auto text-xs text-indigo-300 group-hover:text-white transition inline-flex items-center gap-1\">\n                        Start shipping <span aria-hidden=\"true\">→</span>\n                    </span>\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Example apps showcase -->\n    <section class=\"py-12 md:py-16\" id=\"examples\">\n      <!-- ═══ EXAMPLE APPS SHOWCASE ═══ -->\n      \n      <style>\n        .example-apps-grid {\n          display: grid;\n          gap: 1px;\n          background: rgba(255, 255, 255, 0.04);\n          border-radius: 16px;\n          overflow: hidden;\n        }\n        @media (min-width: 768px) {\n          .example-apps-grid { grid-template-columns: repeat(3, 1fr); }\n        }\n        .example-app-card {\n          background: rgba(15, 23, 42, 0.95);\n          padding: 1.75rem;\n          display: flex;\n          flex-direction: column;\n          gap: 1rem;\n          transition: background 0.3s ease;\n          position: relative;\n        }\n        .example-app-card:hover {\n          background: rgba(30, 41, 59, 0.7);\n        }\n        .example-app-card::after {\n          content: '';\n          position: absolute;\n          bottom: 0;\n          left: 1.75rem;\n          right: 1.75rem;\n          height: 1px;\n          background: linear-gradient(90deg, transparent, rgba(52, 211, 153, 0.15), transparent);\n          opacity: 0;\n          transition: opacity 0.3s ease;\n        }\n        .example-app-card:hover::after {\n          opacity: 1;\n        }\n        .example-app-icon {\n          width: 40px;\n          height: 40px;\n          border-radius: 10px;\n          display: flex;\n          align-items: center;\n          justify-content: center;\n          flex-shrink: 0;\n        }\n        .example-app-link {\n          display: inline-flex;\n          align-items: center;\n          gap: 6px;\n          font-size: 13px;\n          font-weight: 500;\n          color: rgba(52, 211, 153, 0.7);\n          transition: color 0.2s ease, gap 0.2s ease;\n          margin-top: auto;\n        }\n        .example-app-link:hover {\n          color: rgb(52, 211, 153);\n          gap: 8px;\n        }\n        .example-app-link svg {\n          transition: transform 0.2s ease;\n        }\n        .example-app-link:hover svg {\n          transform: translateX(2px);\n        }\n        .example-app-tag {\n          display: inline-flex;\n          align-items: center;\n          gap: 4px;\n          font-size: 10px;\n          font-weight: 600;\n          letter-spacing: 0.06em;\n          text-transform: uppercase;\n          padding: 2px 8px;\n          border-radius: 4px;\n        }\n      </style>\n      \n      <div class=\"max-w-3xl mx-auto\">\n        <!-- Header -->\n        <div class=\"text-center mb-6\">\n          <div class=\"text-[10px] sm:text-[11px] uppercase tracking-[0.18em] text-white/40 font-semibold mb-2\">Built with ReqRes</div>\n          <p class=\"text-[15px] sm:text-base text-white/55\">Real apps, zero backend code. See what you can build.</p>\n        </div>\n      \n        <!-- Cards grid -->\n        <div class=\"example-apps-grid rounded-2xl border border-white/[0.06]\">\n      \n          <!-- Notes App -->\n          <div class=\"example-app-card\">\n            <div class=\"flex items-start gap-3\">\n              <div class=\"example-app-icon border border-amber-400/20 bg-amber-400/[0.06]\">\n                <svg class=\"w-[18px] h-[18px] text-amber-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/>\n                  <polyline points=\"14 2 14 8 20 8\"/>\n                  <line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/>\n                  <line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/>\n                  <polyline points=\"10 9 9 9 8 9\"/>\n                </svg>\n              </div>\n              <div>\n                <h3 class=\"text-[15px] font-semibold text-white/90\">Notes App</h3>\n                <span class=\"example-app-tag text-amber-300/70 bg-amber-400/[0.08] border border-amber-400/10 mt-1\">Interactive</span>\n              </div>\n            </div>\n            <p class=\"text-[13px] leading-relaxed text-white/45\">\n              Full CRUD notes app with collections, create, edit, and delete. Runs inside the ReqRes dashboard.\n            </p>\n            <a href=\"https://app.reqres.in/examples/notes-app\" class=\"example-app-link\" data-visitors-event=\"Example App Click\" data-visitors-source=\"example_apps_card\">\n              Try it\n              <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n            </a>\n          </div>\n      \n          <!-- Task Register -->\n          <div class=\"example-app-card\">\n            <div class=\"flex items-start gap-3\">\n              <div class=\"example-app-icon border border-indigo-400/20 bg-indigo-400/[0.06]\">\n                <svg class=\"w-[18px] h-[18px] text-indigo-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M9 11l3 3L22 4\"/>\n                  <path d=\"M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11\"/>\n                </svg>\n              </div>\n              <div>\n                <h3 class=\"text-[15px] font-semibold text-white/90\">Task Register</h3>\n                <span class=\"example-app-tag text-indigo-300/70 bg-indigo-400/[0.08] border border-indigo-400/10 mt-1\">Standalone</span>\n              </div>\n            </div>\n            <p class=\"text-[13px] leading-relaxed text-white/45\">\n              Operations task manager with statuses, priorities, and filtering. Deployed as its own app with auth.\n            </p>\n            <a href=\"https://demo.reqres.in\" class=\"example-app-link\" target=\"_blank\" rel=\"noreferrer\" data-visitors-event=\"Example App Click\" data-visitors-source=\"example_apps_card\">\n              Open demo\n              <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n            </a>\n          </div>\n      \n          <!-- Waitlist -->\n          <div class=\"example-app-card\">\n            <div class=\"flex items-start gap-3\">\n              <div class=\"example-app-icon border border-emerald-400/20 bg-emerald-400/[0.06]\">\n                <svg class=\"w-[18px] h-[18px] text-emerald-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/>\n                  <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n                  <path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/>\n                  <path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/>\n                </svg>\n              </div>\n              <div>\n                <h3 class=\"text-[15px] font-semibold text-white/90\">Waitlist</h3>\n                <span class=\"example-app-tag text-emerald-300/70 bg-emerald-400/[0.08] border border-emerald-400/10 mt-1\">Open source</span>\n              </div>\n            </div>\n            <p class=\"text-[13px] leading-relaxed text-white/45\">\n              Email signup waitlist with position tracking, admin dashboard, and magic-link auth. Fork and deploy.\n            </p>\n            <a href=\"https://reqres-waitlist-demo.reqres.workers.dev\" class=\"example-app-link\" target=\"_blank\" rel=\"noreferrer\" data-visitors-event=\"Example App Click\" data-visitors-source=\"example_apps_card\">\n              View demo\n              <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n            </a>\n          </div>\n      \n        </div>\n      </div>    </section>\n\n    <!-- HOW REQRES FITS - Comparison cards -->\n    <style>\n      .compare-card {\n        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n        cursor: pointer;\n      }\n      .compare-card:hover {\n        border-color: rgba(255,255,255,0.12);\n      }\n      .compare-card.active {\n        border-color: rgba(52, 211, 153, 0.2);\n        background: rgba(52, 211, 153, 0.03);\n      }\n      .compare-answer {\n        display: grid;\n        grid-template-rows: 0fr;\n        transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;\n        opacity: 0;\n      }\n      .compare-answer.open {\n        grid-template-rows: 1fr;\n        opacity: 1;\n      }\n      .compare-answer > div {\n        overflow: hidden;\n      }\n      .compare-card .compare-arrow {\n        transition: transform 0.3s ease;\n      }\n      .compare-card.active .compare-arrow {\n        transform: rotate(180deg);\n      }\n    </style>\n\n    <section class=\"py-10 md:py-14\">\n      <div class=\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\">\n\n        <!-- Section header -->\n        <div data-reveal class=\"text-center mb-8 md:mb-10\">\n          <div class=\"text-[11px] uppercase tracking-[0.18em] text-emerald-300/70 font-semibold mb-3\">How ReqRes fits</div>\n          <p class=\"text-sm sm:text-[15px] text-white/45 leading-relaxed max-w-md mx-auto\">\n            Not a replacement for tools you already use.<br>\n            A shortcut that removes the ones you don't need.\n          </p>\n        </div>\n\n        <!-- Cards - 2x2 grid -->\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-3\" id=\"compareCards\">\n\n          <!-- Postman -->\n          <div data-reveal class=\"compare-card rounded-2xl border border-white/[0.06] bg-white/[0.015] px-5 py-4 md:px-6\" data-card=\"postman\">\n            <div class=\"flex items-center justify-between\">\n              <div class=\"flex items-center gap-3.5\">\n                <div class=\"w-9 h-9 rounded-lg bg-white/[0.04] border border-white/[0.06] flex items-center justify-center shrink-0\">\n                  <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\">\n                    <circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"#FF6C37\" opacity=\"0.85\"/>\n                    <path d=\"M10 8.5l5.5 3.5-5.5 3.5v-7z\" fill=\"white\"/>\n                  </svg>\n                </div>\n                <div>\n                  <span class=\"text-[13px] font-medium text-white/70\">vs Postman</span>\n                </div>\n              </div>\n              <svg class=\"compare-arrow w-4 h-4 text-white/50\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n            </div>\n            <div class=\"compare-answer\">\n              <div>\n                <div class=\"pt-4 pb-1\">\n                  <p class=\"text-[14px] text-white/55 leading-relaxed\">Postman tests APIs. ReqRes <span class=\"text-white/80 font-medium\">is the API</span> - create a project and Postman has something real to hit, with data that persists.</p>\n                  <a href=\"/compared/postman\" class=\"inline-flex items-center gap-1.5 mt-3 text-[12px] text-emerald-400/60 hover:text-emerald-300 transition-colors\">\n                    Read full comparison\n                    <svg class=\"w-3 h-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- JSON Server -->\n          <div data-reveal style=\"transition-delay: 60ms\" class=\"compare-card rounded-2xl border border-white/[0.06] bg-white/[0.015] px-5 py-4 md:px-6\" data-card=\"json-server\">\n            <div class=\"flex items-center justify-between\">\n              <div class=\"flex items-center gap-3.5\">\n                <div class=\"w-9 h-9 rounded-lg bg-white/[0.04] border border-white/[0.06] flex items-center justify-center shrink-0\">\n                  <svg class=\"w-5 h-5 text-white/80\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                    <path d=\"M6 4h9l3 3v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z\"/>\n                    <path d=\"M14 4v4h4\"/>\n                    <path d=\"M9 13l-1.5 2 1.5 2\"/>\n                    <path d=\"M15 13l1.5 2-1.5 2\"/>\n                  </svg>\n                </div>\n                <div>\n                  <span class=\"text-[13px] font-medium text-white/70\">vs JSON Server</span>\n                </div>\n              </div>\n              <svg class=\"compare-arrow w-4 h-4 text-white/50\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n            </div>\n            <div class=\"compare-answer\">\n              <div>\n                <div class=\"pt-4 pb-1\">\n                  <p class=\"text-[14px] text-white/55 leading-relaxed\">JSON Server gives you a local mock API from a JSON file. ReqRes is <span class=\"text-white/80 font-medium\">hosted, persistent, and shared</span> - your whole team hits the same endpoints without running anything locally.</p>\n                  <a href=\"/compared\" class=\"inline-flex items-center gap-1.5 mt-3 text-[12px] text-emerald-400/60 hover:text-emerald-300 transition-colors\">\n                    See all comparisons\n                    <svg class=\"w-3 h-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- WireMock -->\n          <div data-reveal style=\"transition-delay: 120ms\" class=\"compare-card rounded-2xl border border-white/[0.06] bg-white/[0.015] px-5 py-4 md:px-6\" data-card=\"wiremock\">\n            <div class=\"flex items-center justify-between\">\n              <div class=\"flex items-center gap-3.5\">\n                <div class=\"w-9 h-9 rounded-lg bg-white/[0.04] border border-white/[0.06] flex items-center justify-center shrink-0\">\n                  <svg class=\"w-5 h-5 text-white/80\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                    <rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/>\n                    <path d=\"M3 10h18\"/>\n                    <path d=\"M8 15h2\"/>\n                    <path d=\"M13 15h3\"/>\n                  </svg>\n                </div>\n                <div>\n                  <span class=\"text-[13px] font-medium text-white/70\">vs WireMock</span>\n                </div>\n              </div>\n              <svg class=\"compare-arrow w-4 h-4 text-white/50\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n            </div>\n            <div class=\"compare-answer\">\n              <div>\n                <div class=\"pt-4 pb-1\">\n                  <p class=\"text-[14px] text-white/55 leading-relaxed\">WireMock is powerful but requires JVM setup and configuration. ReqRes gives you <span class=\"text-white/80 font-medium\">stable test endpoints in 30 seconds</span> - no Java, no Docker, no local setup.</p>\n                  <a href=\"/compared\" class=\"inline-flex items-center gap-1.5 mt-3 text-[12px] text-emerald-400/60 hover:text-emerald-300 transition-colors\">\n                    See all comparisons\n                    <svg class=\"w-3 h-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Supabase -->\n          <div data-reveal style=\"transition-delay: 180ms\" class=\"compare-card rounded-2xl border border-white/[0.06] bg-white/[0.015] px-5 py-4 md:px-6\" data-card=\"supabase\">\n            <div class=\"flex items-center justify-between\">\n              <div class=\"flex items-center gap-3.5\">\n                <div class=\"w-9 h-9 rounded-lg bg-white/[0.04] border border-white/[0.06] flex items-center justify-center shrink-0\">\n                  <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\">\n                    <path d=\"M13.5 21.1c-.4.5-1.2.1-1.2-.6V13h8.1c.7 0 1.1.8.6 1.3L13.5 21z\" fill=\"#3ECF8E\"/>\n                    <path d=\"M10.5 2.9c.4-.5 1.2-.1 1.2.6V11H3.6c-.7 0-1.1-.8-.6-1.3L10.5 3z\" fill=\"#3ECF8E\" opacity=\".6\"/>\n                  </svg>\n                </div>\n                <div>\n                  <span class=\"text-[13px] font-medium text-white/70\">vs Supabase</span>\n                </div>\n              </div>\n              <svg class=\"compare-arrow w-4 h-4 text-white/50\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n            </div>\n            <div class=\"compare-answer\">\n              <div>\n                <div class=\"pt-4 pb-1\">\n                  <p class=\"text-[14px] text-white/55 leading-relaxed\">Supabase is a production database you own. ReqRes is the backend you use <span class=\"text-white/80 font-medium\">before you need one</span> - for prototypes, demos, QA, and client-only apps.</p>\n                  <a href=\"/compared/supabase\" class=\"inline-flex items-center gap-1.5 mt-3 text-[12px] text-emerald-400/60 hover:text-emerald-300 transition-colors\">\n                    Read full comparison\n                    <svg class=\"w-3 h-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Firebase -->\n          <div data-reveal style=\"transition-delay: 240ms\" class=\"compare-card rounded-2xl border border-white/[0.06] bg-white/[0.015] px-5 py-4 md:px-6\" data-card=\"firebase\">\n            <div class=\"flex items-center justify-between\">\n              <div class=\"flex items-center gap-3.5\">\n                <div class=\"w-9 h-9 rounded-lg bg-white/[0.04] border border-white/[0.06] flex items-center justify-center shrink-0\">\n                  <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\">\n                    <path d=\"M5.8 18.6L8.4 4.8c.1-.4.5-.5.8-.3l3 2.8-6.4 11.3z\" fill=\"#FFA000\"/>\n                    <path d=\"M18.2 18.6L15.6 6.4c-.1-.3-.4-.4-.6-.3L5.8 18.6l5.7 3.4c.2.1.5.1.7 0l6-3.4z\" fill=\"#F57C00\"/>\n                    <path d=\"M11.5 11.5l-3-5.5c-.2-.3-.6-.3-.7 0L5.8 18.6l5.7-7.1z\" fill=\"#FFCA28\"/>\n                  </svg>\n                </div>\n                <div>\n                  <span class=\"text-[13px] font-medium text-white/70\">vs Firebase</span>\n                </div>\n              </div>\n              <svg class=\"compare-arrow w-4 h-4 text-white/50\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n            </div>\n            <div class=\"compare-answer\">\n              <div>\n                <div class=\"pt-4 pb-1\">\n                  <p class=\"text-[14px] text-white/55 leading-relaxed\">Firebase is a full Google platform. ReqRes is <span class=\"text-white/80 font-medium\">simpler and faster</span> - no SDK, no security rules, just REST endpoints in 30 seconds.</p>\n                  <a href=\"/compared/firebase\" class=\"inline-flex items-center gap-1.5 mt-3 text-[12px] text-emerald-400/60 hover:text-emerald-300 transition-colors\">\n                    Read full comparison\n                    <svg class=\"w-3 h-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Vercel -->\n          <div data-reveal style=\"transition-delay: 300ms\" class=\"compare-card rounded-2xl border border-white/[0.06] bg-white/[0.015] px-5 py-4 md:px-6\" data-card=\"vercel\">\n            <div class=\"flex items-center justify-between\">\n              <div class=\"flex items-center gap-3.5\">\n                <div class=\"w-9 h-9 rounded-lg bg-white/[0.04] border border-white/[0.06] flex items-center justify-center shrink-0\">\n                  <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M12 2L2 22h20L12 2z\"/></svg>\n                </div>\n                <div>\n                  <span class=\"text-[13px] font-medium text-white/70\">vs Vercel</span>\n                </div>\n              </div>\n              <svg class=\"compare-arrow w-4 h-4 text-white/50\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n            </div>\n            <div class=\"compare-answer\">\n              <div>\n                <div class=\"pt-4 pb-1\">\n                  <p class=\"text-[14px] text-white/55 leading-relaxed\">Vercel deploys your frontend. ReqRes is <span class=\"text-white/80 font-medium\">the backend it calls</span> - collections, auth, and logs without writing serverless functions.</p>\n                  <a href=\"/compared/vercel\" class=\"inline-flex items-center gap-1.5 mt-3 text-[12px] text-emerald-400/60 hover:text-emerald-300 transition-colors\">\n                    Read full comparison\n                    <svg class=\"w-3 h-3\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n        <!-- See all comparisons link -->\n        <div data-reveal style=\"transition-delay: 240ms\" class=\"text-center mt-6\">\n          <a href=\"/compared\" class=\"inline-flex items-center gap-1.5 text-[13px] text-white/50 hover:text-white/80 transition-colors\">\n            See all comparisons\n            <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n          </a>\n        </div>\n\n      </div>\n    </section>\n\n    <script>\n    (function() {\n      const cards = document.querySelectorAll('#compareCards .compare-card');\n\n      cards.forEach(card => {\n        // Make cards keyboard-focusable and announce as buttons\n        card.setAttribute('role', 'button');\n        card.setAttribute('tabindex', '0');\n        card.setAttribute('aria-expanded', 'false');\n\n        function toggle(e) {\n          // Don't toggle if clicking the comparison link\n          if (e.target.closest('a')) return;\n\n          const answer = card.querySelector('.compare-answer');\n          const isActive = card.classList.contains('active');\n\n          // Close all\n          cards.forEach(c => {\n            c.classList.remove('active');\n            c.querySelector('.compare-answer').classList.remove('open');\n            c.setAttribute('aria-expanded', 'false');\n          });\n\n          // Open clicked (if it wasn't already open)\n          if (!isActive) {\n            card.classList.add('active');\n            answer.classList.add('open');\n            card.setAttribute('aria-expanded', 'true');\n          }\n        }\n\n        card.addEventListener('click', toggle);\n        card.addEventListener('keydown', (e) => {\n          if (e.key === 'Enter' || e.key === ' ') {\n            e.preventDefault();\n            toggle(e);\n          }\n        });\n      });\n    })();\n    </script>\n\n    <!-- REMOVED: Modern Team Bento, Tagline Strip, Compared Platforms, Bento Overview, Deep Dive Chapters, Lifecycle, Code Realism, Notes Example, Use Cases, Trust/Foundations - content moved to /for/* persona pages -->\n\n    <!-- PRICING -->\n    <section id=\"pricing\" class=\"py-20 md:py-24 border-b border-white/5\">\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6\">\n            <div class=\"space-y-2 text-center\">\n                <p\n                    class=\"text-[11px] uppercase tracking-[0.25em] text-white/40 font-semibold\"\n                >\n                    Pricing\n                </p>\n                <h2 class=\"text-2xl md:text-3xl font-semibold tracking-tight\">\n                    Start free. Scale when you're ready.\n                </h2>\n                <p class=\"text-sm text-white/50\">\n                    Same collections, same auth, same endpoints. Just more room to build.\n                </p>\n            </div>\n\n            <div\n                class=\"mt-8 rounded-2xl border border-white/[0.08] bg-white/[0.02] px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\"\n            >\n                <div class=\"flex items-center gap-3\">\n                    <span class=\"inline-flex items-center rounded-md bg-emerald-500/10 border border-emerald-400/15 px-2 py-0.5 text-[11px] font-semibold text-emerald-300 uppercase tracking-wider\">Free</span>\n                    <span class=\"text-sm text-white/50\">Collections, app users, and logs - no card required.</span>\n                </div>\n                <div class=\"flex items-center gap-2 shrink-0\">\n                    <a\n                        href=\"https://app.reqres.in\"\n                        class=\"inline-flex items-center justify-center rounded-md border border-white/15 bg-white/5 px-3.5 py-1.5 text-sm font-medium text-white hover:bg-white/10 hover:border-white/25 transition\"\n                        data-visitors-event=\"Signup CTA\"\n                        data-visitors-source=\"pricing\"\n                        data-visitors-plan=\"Free\"\n                    >\n                        Start free\n                    </a>\n                </div>\n            </div>\n\n            <!-- Individual plans -->\n            <div class=\"mt-8\">\n                <p class=\"text-[11px] uppercase tracking-[0.22em] text-white/40 font-semibold mb-4\">Individual plans</p>\n                <div\n                    class=\"pricing-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5\"\n                >\n                <div\n                    class=\"rounded-2xl border border-white/10 bg-white/[0.03] p-6 flex flex-col gap-5\"\n                >\n                    <div class=\"space-y-1\">\n                        <div class=\"text-sm font-semibold text-white\">Lite</div>\n                        <div class=\"text-3xl font-bold text-white\" data-pd-price=\"5\"><span data-pd-currency-symbol>$</span><span data-pd-price-integer>5</span><span class=\"text-lg font-medium text-white/40\">/mo</span></div>\n                        <div class=\"text-xs text-white/50\">For QA and test automation</div>\n                    </div>\n                    <div class=\"space-y-3\">\n                        <p class=\"text-[11px] uppercase tracking-widest text-white/50 font-medium\">Everything in Free, plus</p>\n                        <ul class=\"space-y-2 text-sm text-white/75\">\n                            <li class=\"flex items-center gap-2\"><span class=\"text-white/25\">&#x2713;</span> 1,000 requests/day (4x free)</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-white/25\">&#x2713;</span> No trial expiry</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-white/25\">&#x2713;</span> Keep your test suite running</li>\n                        </ul>\n                    </div>\n                    <div class=\"pt-2 mt-auto\">\n                        <a\n                            href=\"https://app.reqres.in/upgrade\"\n                            class=\"inline-flex w-full items-center justify-center rounded-md border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-white/10 hover:border-white/25\"\n                            data-visitors-event=\"Signup CTA\"\n                            data-visitors-source=\"pricing\"\n                            data-visitors-plan=\"Lite\"\n                        >\n                            Upgrade to Lite\n                        </a>\n                    </div>\n                </div>\n\n                <div\n                    class=\"rounded-2xl border border-white/10 bg-white/[0.03] p-6 flex flex-col gap-5\"\n                >\n                    <div class=\"space-y-1\">\n                        <div class=\"text-sm font-semibold text-white\">Dev</div>\n                        <div class=\"text-3xl font-bold text-white\" data-pd-price=\"12\"><span data-pd-currency-symbol>$</span><span data-pd-price-integer>12</span><span class=\"text-lg font-medium text-white/40\">/mo</span></div>\n                        <div class=\"text-xs text-white/50\">For freelancers and side projects</div>\n                    </div>\n                    <div class=\"space-y-3\">\n                        <p class=\"text-[11px] uppercase tracking-widest text-white/50 font-medium\">Everything in Free, plus</p>\n                        <ul class=\"space-y-2 text-sm text-white/75\">\n                            <li class=\"flex items-center gap-2\"><span class=\"text-white/25\">&#x2713;</span> Persistent collections with custom schemas</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-white/25\">&#x2713;</span> 30-day request logs for debugging</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-white/25\">&#x2713;</span> Automations on data changes</li>\n                        </ul>\n                    </div>\n                    <div class=\"pt-2 mt-auto\">\n                        <a\n                            href=\"https://app.reqres.in\"\n                            class=\"inline-flex w-full items-center justify-center rounded-md border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-white/10 hover:border-white/25\"\n                            data-visitors-event=\"Signup CTA\"\n                            data-visitors-source=\"pricing\"\n                            data-visitors-plan=\"Dev\"\n                        >\n                            Get started\n                        </a>\n                    </div>\n                </div>\n\n                <div\n                    class=\"rounded-2xl border border-white/10 bg-white/[0.03] p-6 flex flex-col gap-5\"\n                >\n                    <div class=\"space-y-1\">\n                        <div class=\"text-sm font-semibold text-white\">Pro</div>\n                        <div class=\"text-3xl font-bold text-white\" data-pd-price=\"29\"><span data-pd-currency-symbol>$</span><span data-pd-price-integer>29</span><span class=\"text-lg font-medium text-white/40\">/mo</span></div>\n                        <div class=\"text-xs text-white/50\">For agencies and studios</div>\n                    </div>\n                    <div class=\"space-y-3\">\n                        <p class=\"text-[11px] uppercase tracking-widest text-white/50 font-medium\">Everything in Dev, plus</p>\n                        <ul class=\"space-y-2 text-sm text-white/75\">\n                            <li class=\"flex items-center gap-2\"><span class=\"text-white/25\">&#x2713;</span> Multiple projects for different clients</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-white/25\">&#x2713;</span> App users for production workloads</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-white/25\">&#x2713;</span> Webhooks for external integrations</li>\n                        </ul>\n                    </div>\n                    <div class=\"pt-2 mt-auto\">\n                        <a\n                            href=\"https://app.reqres.in\"\n                            class=\"inline-flex w-full items-center justify-center rounded-md border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-white/10 hover:border-white/25\"\n                            data-visitors-event=\"Signup CTA\"\n                            data-visitors-source=\"pricing\"\n                            data-visitors-plan=\"Pro\"\n                        >\n                            Upgrade to Pro\n                        </a>\n                    </div>\n                </div>\n                </div>\n            </div>\n\n            <!-- Team & Enterprise plans -->\n            <div class=\"mt-8\">\n                <p class=\"text-[11px] uppercase tracking-[0.22em] text-white/40 font-semibold mb-4\">Team &amp; Enterprise plans</p>\n                <div\n                    class=\"pricing-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5\"\n                >\n                <div\n                    class=\"pro-card relative overflow-hidden rounded-2xl border border-indigo-500/30 bg-white/[0.05] p-6 shadow-[0_0_0_1px_rgba(90,69,255,0.20),0_20px_70px_rgba(90,69,255,0.10)] flex flex-col gap-5\"\n                >\n                    <div class=\"space-y-1\">\n                        <div class=\"flex items-center gap-2\">\n                            <div class=\"text-sm font-semibold text-white\">Team</div>\n                            <span\n                                class=\"inline-flex items-center rounded-full bg-indigo-500/15 border border-indigo-400/20 px-2.5 py-0.5 text-[11px] font-semibold text-indigo-200\"\n                            >\n                                Recommended\n                            </span>\n                        </div>\n                        <div class=\"text-3xl font-bold text-white\" data-pd-price=\"79\"><span data-pd-currency-symbol>$</span><span data-pd-price-integer>79</span><span class=\"text-lg font-medium text-white/40\">/mo</span></div>\n                        <div class=\"text-xs text-white/50\">For QA teams and agencies</div>\n                    </div>\n                    <div class=\"space-y-3\">\n                        <p class=\"text-[11px] uppercase tracking-widest text-white/50 font-medium\">Everything in Pro, plus</p>\n                        <ul class=\"space-y-2 text-sm text-white/75\">\n                            <li class=\"flex items-center gap-2\"><span class=\"text-indigo-400/60\">&#x2713;</span> Shared projects &mdash; your team uses one account, not ten</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-indigo-400/60\">&#x2713;</span> Scoped API keys per engineer with usage tracking</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-indigo-400/60\">&#x2713;</span> 100K requests/day for the whole team</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-indigo-400/60\">&#x2713;</span> 30-day request logs for debugging failed test runs</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-indigo-400/60\">&#x2713;</span> One invoice for the company</li>\n                        </ul>\n                    </div>\n                    <div class=\"pt-2 mt-auto\">\n                        <a\n                            href=\"https://app.reqres.in\"\n                            class=\"inline-flex w-full items-center justify-center rounded-md bg-white px-4 py-2.5 text-sm font-semibold text-black shadow-[0_1px_3px_rgba(0,0,0,0.12)] transition hover:bg-white/90\"\n                            data-visitors-event=\"Signup CTA\"\n                            data-visitors-source=\"pricing\"\n                            data-visitors-plan=\"Team\"\n                        >\n                            Get started\n                        </a>\n                    </div>\n                </div>\n\n                <div\n                    class=\"relative overflow-hidden rounded-2xl border border-emerald-400/30 bg-emerald-500/[0.04] p-6 flex flex-col gap-5\"\n                >\n                    <div class=\"space-y-1\">\n                        <div class=\"flex items-center gap-2\">\n                            <div class=\"text-sm font-semibold text-white\">\n                                Agent Developer\n                            </div>\n                            <span\n                                class=\"inline-flex items-center rounded-full bg-emerald-500/15 border border-emerald-400/25 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-200\"\n                            >\n                                New\n                            </span>\n                        </div>\n                        <div class=\"text-3xl font-bold text-white\" data-pd-price=\"49\"><span data-pd-currency-symbol>$</span><span data-pd-price-integer>49</span><span class=\"text-lg font-medium text-white/40\">/mo</span></div>\n                        <div class=\"text-xs text-white/50\">For AI coding agents</div>\n                    </div>\n                    <div class=\"space-y-3\">\n                        <p class=\"text-[11px] uppercase tracking-widest text-white/50 font-medium\">Everything in Dev, plus</p>\n                        <ul class=\"space-y-2 text-sm text-white/75\">\n                            <li class=\"flex items-center gap-2\"><span class=\"text-emerald-400/70\">&#x2713;</span> 10M requests/month to <code class=\"text-[11px] text-emerald-300/80\">/agent/v1/*</code></li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-emerald-400/70\">&#x2713;</span> All 15 failure scenarios unlocked (free tier has 3)</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-emerald-400/70\">&#x2713;</span> Usage dashboard + issued <code class=\"text-[11px] text-emerald-300/80\">x-agent-id</code> key</li>\n                        </ul>\n                    </div>\n                    <div class=\"pt-2 mt-auto\">\n                        <a\n                            href=\"/for/ai-agents\"\n                            class=\"inline-flex w-full items-center justify-center rounded-md bg-emerald-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-400\"\n                            data-visitors-event=\"Signup CTA\"\n                            data-visitors-source=\"pricing\"\n                            data-visitors-plan=\"Agent Developer\"\n                        >\n                            For AI agents &rarr;\n                        </a>\n                    </div>\n                </div>\n\n                <div\n                    class=\"relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 flex flex-col gap-5\"\n                >\n                    <div class=\"space-y-1\">\n                        <div class=\"flex items-center gap-2\">\n                            <div class=\"text-sm font-semibold text-white\">\n                                Agent Platform\n                            </div>\n                            <span\n                                class=\"inline-flex items-center rounded-full bg-white/10 border border-white/15 px-2.5 py-0.5 text-[11px] font-semibold text-white/70\"\n                            >\n                                Contact sales\n                            </span>\n                        </div>\n                        <div class=\"text-xl font-semibold text-white/80\">Custom</div>\n                        <div class=\"text-xs text-white/50\">For AI coding tool companies</div>\n                    </div>\n                    <div class=\"space-y-3\">\n                        <p class=\"text-[11px] uppercase tracking-widest text-white/50 font-medium\">Everything in Agent Developer, plus</p>\n                        <ul class=\"space-y-2 text-sm text-white/75\">\n                            <li class=\"flex items-center gap-2\"><span class=\"text-emerald-400/70\">&#x2713;</span> 100M+ requests/month, custom cap</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-emerald-400/70\">&#x2713;</span> Private namespace with isolated rate-limit tenancy</li>\n                            <li class=\"flex items-center gap-2\"><span class=\"text-emerald-400/70\">&#x2713;</span> Custom SLA and invoicing</li>\n                        </ul>\n                    </div>\n                    <div class=\"pt-2 mt-auto\">\n                        <a\n                            href=\"mailto:hello@reqres.in?subject=Agent%20Platform%20enquiry\"\n                            class=\"inline-flex w-full items-center justify-center rounded-md border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10\"\n                            data-visitors-event=\"Contact Sales\"\n                            data-visitors-source=\"pricing\"\n                            data-visitors-plan=\"Agent Platform\"\n                        >\n                            Get in touch\n                        </a>\n                    </div>\n                </div>\n                </div>\n            </div>\n            <div\n                class=\"enterprise-bar mt-6 rounded-2xl border border-amber-200/15 bg-white/[0.02] px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\"\n            >\n                <div class=\"enterprise-content flex items-center gap-3\">\n                    <div class=\"space-y-0.5\">\n                        <div class=\"text-sm font-semibold text-white/90\">\n                            Enterprise\n                        </div>\n                        <div class=\"text-xs text-white/50\">\n                            Custom limits, SSO, or data residency - let's tailor a plan.\n                        </div>\n                    </div>\n                </div>\n                <div class=\"enterprise-content flex items-center gap-2 shrink-0\">\n                    <a\n                        href=\"mailto:hello@reqres.in\"\n                        class=\"inline-flex items-center justify-center rounded-md border border-amber-300/20 bg-amber-500/10 px-3.5 py-1.5 text-sm font-medium text-amber-200/90 transition hover:bg-amber-500/15 hover:border-amber-300/30\"\n                    >\n                        Contact us &rarr;\n                    </a>\n                </div>\n            </div>\n\n            <!-- Social proof -->\n            <p class=\"text-center text-sm text-white/40 mt-8 mb-4\">\n                Teams use ReqRes for payment system testing, doctor scheduling APIs, recipe apps, Instagram clone backends, and QA automation.\n            </p>\n\n            <!-- Self-hosted card -->\n            <div class=\"mt-4 rounded-2xl border border-sky-400/15 bg-sky-500/[0.04] p-5 sm:p-6\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\n                    <div class=\"flex items-start gap-4\">\n                        <div class=\"shrink-0 mt-0.5 w-10 h-10 rounded-xl border border-sky-400/20 bg-sky-500/10 flex items-center justify-center\">\n                            <svg class=\"w-5 h-5 text-sky-400\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 12H2\"/><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"/><line x1=\"6\" y1=\"16\" x2=\"6.01\" y2=\"16\"/><line x1=\"10\" y1=\"16\" x2=\"10.01\" y2=\"16\"/></svg>\n                        </div>\n                        <div>\n                            <div class=\"text-sm font-semibold text-white/90\">Run ReqRes in your own infrastructure</div>\n                            <p class=\"text-xs text-white/50 mt-1 max-w-md leading-relaxed\">\n                                Your CI pipeline shouldn't depend on a third-party API. Deploy the same endpoints your test suites already use - inside your own network. No external calls. No rate limits. No 3am pipeline failures.\n                            </p>\n                            <div class=\"flex items-center gap-2 mt-2\">\n                                <code class=\"inline-block text-[11px] text-sky-300/80 bg-sky-500/10 rounded px-2 py-1 font-mono\">docker run -p 3000:3000 reqres/reqres-api</code>\n                                <button onclick=\"navigator.clipboard.writeText('docker run -p 3000:3000 reqres/reqres-api')\" class=\"shrink-0 p-1 rounded hover:bg-white/10 transition\" title=\"Copy command\">\n                                    <svg class=\"w-3.5 h-3.5 text-sky-400/60\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg>\n                                </button>\n                            </div>\n                            <p class=\"text-[11px] text-white/30 mt-1.5\">From $499/year per team.</p>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col gap-2 shrink-0\">\n                        <a\n                            href=\"/self-hosted\"\n                            class=\"inline-flex items-center justify-center gap-1.5 rounded-lg border border-sky-400/20 bg-sky-500/10 px-4 py-2 text-sm font-medium text-sky-300 hover:bg-sky-500/15 hover:border-sky-400/30 transition-all\"\n                            data-visitors-event=\"Self-Hosted CTA Click\"\n                            data-visitors-source=\"pricing\"\n                        >\n                            Learn more\n                            <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Teams + Classroom callouts -->\n            <div class=\"mt-6 flex flex-col sm:flex-row items-center justify-center gap-3\">\n                <a\n                    href=\"/teams\"\n                    class=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-emerald-500/20 bg-emerald-500/5 text-emerald-400 text-sm font-medium hover:bg-emerald-500/10 hover:border-emerald-500/30 transition-all\"\n                    data-visitors-event=\"Teams CTA Click\"\n                    data-visitors-source=\"pricing\"\n                >\n                    <span>Looking for QA team plans?</span>\n                    <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                </a>\n                <a\n                    href=\"/for/educators\"\n                    class=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-purple-500/20 bg-purple-500/5 text-purple-300 text-sm font-medium hover:bg-purple-500/10 hover:border-purple-500/30 transition-all\"\n                    data-visitors-event=\"Classroom CTA Click\"\n                    data-visitors-source=\"pricing\"\n                >\n                    <span>Teaching a class? Classroom plans from $49/mo</span>\n                    <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- FINAL CTA -->\n    <section class=\"py-20 md:py-24\">\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div\n                class=\"relative overflow-hidden rounded-[32px] border border-white/10 bg-gradient-to-r from-indigo-600/15 via-slate-900/80 to-slate-900/70 p-8 md:p-10 shadow-[0_20px_80px_rgba(0,0,0,0.6)]\"\n            >\n                <div\n                    class=\"pointer-events-none absolute inset-0 overflow-hidden rounded-[32px]\"\n                >\n                    <svg\n                        class=\"absolute inset-0 h-full w-full\"\n                        viewBox=\"0 0 1400 420\"\n                        fill=\"none\"\n                        xmlns=\"http://www.w3.org/2000/svg\"\n                        aria-hidden=\"true\"\n                    >\n                        <defs>\n                            <radialGradient\n                                id=\"rrFooterGlow\"\n                                cx=\"0\"\n                                cy=\"0\"\n                                r=\"1\"\n                                gradientUnits=\"userSpaceOnUse\"\n                                gradientTransform=\"translate(1020 150) rotate(120) scale(560 440)\"\n                            >\n                                <stop stop-color=\"rgba(90,69,255,0.20)\" />\n                                <stop\n                                    offset=\"1\"\n                                    stop-color=\"rgba(90,69,255,0)\"\n                                />\n                            </radialGradient>\n\n                            <linearGradient\n                                id=\"rrFooterStroke\"\n                                x1=\"240\"\n                                y1=\"120\"\n                                x2=\"1200\"\n                                y2=\"320\"\n                                gradientUnits=\"userSpaceOnUse\"\n                            >\n                                <stop stop-color=\"rgba(255,255,255,0.00)\" />\n                                <stop\n                                    offset=\"0.45\"\n                                    stop-color=\"rgba(255,255,255,0.12)\"\n                                />\n                                <stop\n                                    offset=\"1\"\n                                    stop-color=\"rgba(255,255,255,0.00)\"\n                                />\n                            </linearGradient>\n\n                            <linearGradient\n                                id=\"rrFooterAccent\"\n                                x1=\"320\"\n                                y1=\"160\"\n                                x2=\"1240\"\n                                y2=\"340\"\n                                gradientUnits=\"userSpaceOnUse\"\n                            >\n                                <stop stop-color=\"rgba(90,69,255,0.00)\" />\n                                <stop\n                                    offset=\"0.5\"\n                                    stop-color=\"rgba(90,69,255,0.70)\"\n                                />\n                                <stop\n                                    offset=\"1\"\n                                    stop-color=\"rgba(90,69,255,0.00)\"\n                                />\n                            </linearGradient>\n\n                            <!-- mask to keep edges quiet -->\n                            <radialGradient\n                                id=\"rrFooterMask\"\n                                cx=\"0\"\n                                cy=\"0\"\n                                r=\"1\"\n                                gradientUnits=\"userSpaceOnUse\"\n                                gradientTransform=\"translate(700 210) rotate(90) scale(220 720)\"\n                            >\n                                <stop stop-color=\"rgba(255,255,255,0.22)\" />\n                                <stop\n                                    offset=\"0.65\"\n                                    stop-color=\"rgba(255,255,255,0.10)\"\n                                />\n                                <stop\n                                    offset=\"1\"\n                                    stop-color=\"rgba(255,255,255,0.00)\"\n                                />\n                            </radialGradient>\n                        </defs>\n\n                        <!-- glow wash -->\n                        <rect\n                            width=\"1400\"\n                            height=\"420\"\n                            fill=\"url(#rrFooterGlow)\"\n                            opacity=\"0.9\"\n                        />\n\n                        <!-- base lines -->\n                        <g opacity=\"0.85\">\n                            <path\n                                d=\"M140 290 C 360 110, 640 110, 860 290\"\n                                stroke=\"url(#rrFooterStroke)\"\n                                stroke-width=\"2\"\n                                stroke-linecap=\"round\"\n                                opacity=\"0.55\"\n                            />\n                            <path\n                                d=\"M240 330 C 520 140, 780 140, 1180 300\"\n                                stroke=\"url(#rrFooterStroke)\"\n                                stroke-width=\"2\"\n                                stroke-linecap=\"round\"\n                                opacity=\"0.40\"\n                            />\n                            <path\n                                d=\"M160 180 C 420 60, 980 70, 1280 210\"\n                                stroke=\"url(#rrFooterStroke)\"\n                                stroke-width=\"2\"\n                                stroke-linecap=\"round\"\n                                opacity=\"0.35\"\n                            />\n                        </g>\n\n                        <!-- animated dashed accent -->\n                        <path\n                            class=\"rr-footer-dash\"\n                            d=\"M140 290 C 360 110, 640 110, 860 290\"\n                            stroke=\"url(#rrFooterAccent)\"\n                            stroke-width=\"3\"\n                            stroke-linecap=\"round\"\n                            stroke-dasharray=\"7 12\"\n                            opacity=\"0.9\"\n                        />\n\n                        <path\n                            class=\"rr-footer-dash rr-footer-dash-slow\"\n                            d=\"M240 330 C 520 140, 780 140, 1180 300\"\n                            stroke=\"url(#rrFooterAccent)\"\n                            stroke-width=\"3\"\n                            stroke-linecap=\"round\"\n                            stroke-dasharray=\"6 14\"\n                            opacity=\"0.55\"\n                        />\n\n                        <!-- faint nodes -->\n                        <g opacity=\"0.22\">\n                            <circle\n                                cx=\"140\"\n                                cy=\"290\"\n                                r=\"6\"\n                                fill=\"rgba(255,255,255,0.22)\"\n                            />\n                            <circle\n                                cx=\"860\"\n                                cy=\"290\"\n                                r=\"6\"\n             